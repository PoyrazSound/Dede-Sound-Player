<script id="v97-unified-fx-controls-script">
(()=>{
  const root=document.getElementById('fxStudioModal');
  if(!root)return;
  const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
  const formatValue=(input)=>{
    const id=input.id, v=Number(input.value), min=Number(input.min||0), max=Number(input.max||1);
    const unit=(input.parentElement.querySelector('output')?.textContent||'').match(/[A-Za-z%]+|BPM|dB|cent|ms|s|Hz|kHz/g)?.pop()||'';
    if(id.includes('bpm')) return `${Math.round(v)} BPM`;
    if(id.includes('time')||id.includes('predelay')) return `${Math.round(v)} ms`;
    if(id.includes('low')||id.includes('high')||id.includes('cut')||id.includes('freq')) return v>=1000?`${(v/1000).toFixed(v>=10000?0:1)} kHz`:`${Math.round(v)} Hz`;
    if(id.includes('decay')) return `${v.toFixed(1)} s`;
    if(id.includes('ratio')) return `${v.toFixed(1)}:1`;
    if(id.includes('shift')) return `${Math.round(v)} st`;
    if(id.includes('gain')||id.includes('thresh')||id.includes('pres')||id.includes('bass')||id.includes('treble')||id.includes('out_gain')) return `${v.toFixed(Math.abs(v)<10?1:0)} dB`;
    if(max<=1) return `${Math.round(v*100)}%`;
    if(unit) return `${Number.isInteger(v)?v:v.toFixed(2)} ${unit}`;
    return Number.isInteger(v)?String(v):v.toFixed(2);
  };
  const enhance=(input)=>{
    if(input.dataset.dsEnhanced==='1')return;
    input.dataset.dsEnhanced='1';
    const item=input.closest('.fxControlItem'); if(!item)return;
    const wrap=document.createElement('div'); wrap.className='dsHwKnobWrap'; wrap.tabIndex=0;
    const mark=document.createElement('div'); mark.className='dsHwKnobMark';
    const value=document.createElement('div'); value.className='dsHwValue';
    const hint=document.createElement('div'); hint.className='dsHwHint'; hint.textContent='DRAG / WHEEL';
    wrap.appendChild(mark); item.insertBefore(wrap,input); item.appendChild(value); item.appendChild(hint);
    const sync=()=>{
      const min=Number(input.min||0), max=Number(input.max||1), v=Number(input.value||0);
      const pct=clamp((v-min)/(max-min||1),0,1);
      const angle=-135+pct*270;
      wrap.style.setProperty('--pct',`${pct*75}%`);
      wrap.style.setProperty('--angle',`${angle}deg`);
      value.textContent=formatValue(input);
    };
    const stepValue=(dir,large=false)=>{
      const min=Number(input.min||0), max=Number(input.max||1);
      let step=Number(input.step||((max-min)/100)); if(!Number.isFinite(step)||step<=0)step=(max-min)/100;
      const n=clamp(Number(input.value||0)+dir*step*(large?5:1),min,max);
      input.value=String(n); input.dispatchEvent(new Event('input',{bubbles:true})); input.dispatchEvent(new Event('change',{bubbles:true})); sync();
    };
    let dragging=false,lastY=0;
    wrap.addEventListener('pointerdown',e=>{dragging=true;lastY=e.clientY;wrap.setPointerCapture?.(e.pointerId);e.preventDefault()});
    wrap.addEventListener('pointermove',e=>{if(!dragging)return;const dy=lastY-e.clientY;lastY=e.clientY;if(Math.abs(dy)>=1)stepValue(dy,false)});
    wrap.addEventListener('pointerup',e=>{dragging=false;try{wrap.releasePointerCapture?.(e.pointerId)}catch(_){}});
    wrap.addEventListener('pointercancel',()=>dragging=false);
    wrap.addEventListener('wheel',e=>{e.preventDefault();stepValue(e.deltaY<0?1:-1,e.shiftKey)},{passive:false});
    wrap.addEventListener('dblclick',()=>{input.value=input.defaultValue;input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));sync()});
    input.addEventListener('input',sync); input.addEventListener('change',sync); sync();
  };
  const scan=()=>root.querySelectorAll('.dsFxSettingsMount .fxControlItem input[type="range"]').forEach(enhance);
  const obs=new MutationObserver(()=>requestAnimationFrame(scan));
  obs.observe(root,{childList:true,subtree:true});
  scan();
})();
</script>


