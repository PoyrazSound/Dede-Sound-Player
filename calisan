/* ============================================================
   DISTORTION CURVE
============================================================ */

function makeDistortionCurve(amount,type){

    const samples=44100;
    const curve=new Float32Array(samples);

    const k=Math.max(1,amount);

    for(let i=0;i<samples;i++){

        const x=(i*2)/samples-1;

        let y;

        switch(type){

            case "fuzz":
                y=Math.tanh(x*(k*2.2));
                break;

            case "metal":
                y=Math.tanh(
                    x*(2+k*0.5)
                );

                y=Math.sign(y)*
                  Math.pow(Math.abs(y),0.65);
                break;

            case "crunch":
                y=Math.tanh(x*(1+k*0.12));
                break;

            case "distortion":
                y=Math.tanh(x*(1+k*0.18));
                break;

            default:
                y=Math.tanh(x*(1+k*0.08));
        }

        curve[i]=y;
    }

    return curve;
}

