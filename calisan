  function paint(){const z=zones();if(!z)return;[...z.children].forEach((el,i)=>{const on=all||selected.has(i);el.classList.toggle('vmMultiSel',on);el.classList.toggle('sel',!all&&selected.size===1&&selected.has(i));el.setAttribute('aria-selected',on?'true':'false');});}
  function status(t){const s=$('vmStatus');if(s)s.textContent=t}
