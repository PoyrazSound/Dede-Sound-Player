async function loadWavFile(file){

    const arrayBuffer=
        await file.arrayBuffer();

    await initializeAudio();

    const buffer=
        await audioContext.decodeAudioData(
            arrayBuffer.slice(0)
        );

    return {
        file,
        buffer,
        name:file.name
    };
}

async function buildWavMapping(files){

    wavMapping.clear();

    const startNote=
        Number(
            $("startNote").value
        );

    const loaded=[];

    for(
        const file
        of files
    ){

        try{

            loaded.push(
                await loadWavFile(file)
            );

        }catch(e){}
    }

    wavFiles=loaded;

    for(
        let i=0;
        i<wavFiles.length;
        i++
    ){

        if(startNote+i<=127){

            wavMapping.set(
                startNote+i,
                wavFiles[i]
            );
        }
    }

    $("wavInfo").innerHTML=
        "<b>"+
        wavFiles.length+
        " WAV Loaded</b>";

    renderMapping();
}

function renderMapping(){

    const list=$("mappingList");

    if(!wavFiles.length){

        list.style.display="none";
        return;
    }

    list.style.display="block";
    list.innerHTML="";

    for(
        const [note,item]
        of wavMapping
    ){

        const row=
            document.createElement("div");

        row.className="mappingRow";

        row.innerHTML=
            "<span class='mappingNote'>"+
            escapeHTML(
                midiName(note)
            )+
            "</span>"+
            "<span>"+
            escapeHTML(
                item.name
            )+
            "</span>";

        list.appendChild(row);
    }
}

/* ============================================================
   WAV VOICE
============================================================ */

async function createWAVVoice(
    note,
    velocity,
    item,
    startOffset=0
){
    await initializeAudio();

    /* Recover a missing decoded buffer when a program mapping retained the
       File object but not its AudioBuffer. */
    if(!item?.buffer && item?.file instanceof File){
        try{
            item.buffer=await audioContext.decodeAudioData((await item.file.arrayBuffer()).slice(0));
        }catch(err){
            console.error("WAV decode failed:",item?.name,err);
            return null;
        }
    }
    if(!item?.buffer){
        console.warn("WAV sample has no decoded buffer:",item?.name);
        return null;
    }

    const zone=item?.zoneRef||item;
    const source=audioContext.createBufferSource();
    source.buffer=item.buffer;

    const gain=
        audioContext.createGain();

    // Per-sample volume: each mapped zone has its own dB trim.
    const velocityGain=Math.max(.0001,Math.min(1,velocity/127));
    const sampleDb=Number(zone.volume??0);
    const amplitude=Math.max(.0001,Math.min(1,velocityGain*Math.pow(10,sampleDb/20)));

    const now=
        audioContext.currentTime;

    const geStartOffset=Math.max(0,Number(startOffset)||0);
    // Attack/release in Visual Mapping are per-sample milliseconds.
    // Keep the global controls only as fallback for older mappings.
    // GENERAL EDIT is the global envelope. A mapping zone can opt out by
    // explicitly marking its own envelope as custom from the per-note inspector.
    const globalAttack=Math.max(.001,Number($("attack")?.value||.01));
    const globalDecay=Math.max(.001,Number($("decay")?.value||.25));
    const globalSustain=Math.max(0,Math.min(1,Number($("sustain")?.value||.8)));
    const globalRelease=Math.max(.01,Number($("release")?.value||.5));
    const useCustomEnvelope=zone._customEnvelope===true;
    const geAttack=useCustomEnvelope ? Math.max(.001,Number(zone.attack||0)/1000) : globalAttack;
    const geDecay=globalDecay;
    const geSustain=globalSustain;
    const geRelease=useCustomEnvelope ? Math.max(.01,Number(zone.release??200)/1000) : globalRelease;
    const geLegatoStart=geStartOffset>0;

    if(geLegatoStart){
        const legatoEntry=Math.min(.028,Math.max(.008,geAttack*.18));
        gain.gain.setValueAtTime(Math.max(.0001,amplitude*.02),now);
        gain.gain.linearRampToValueAtTime(amplitude,now+legatoEntry);
    }else{
        gain.gain.setValueAtTime(.0001,now);
        gain.gain.linearRampToValueAtTime(amplitude,now+geAttack);
        gain.gain.linearRampToValueAtTime(amplitude*geSustain,now+geAttack+geDecay);
    }

    let rate=1;

    /* Chromatic playback: mapped note is the sample root. */
    if(Number.isFinite(Number(item.sampleNote))){
        rate*=Math.pow(2,(Number(note)-Number(item.sampleNote))/12);
    }

    /* PROGRAM TRANSPOSE / FINE PITCH: per-sound, not global */
    if(typeof activeProgramIndex==='number' && typeof programs!=='undefined' && programs[activeProgramIndex]){
        const ps=programs[activeProgramIndex].settings||{};
        const semitone=Number(ps.transpose||0);
        const cents=Number(ps.finePitch||0)+Number(zone.tune||0);
        rate*=Math.pow(2,(semitone+cents/100)/12);
    } else if(item && Number.isFinite(Number(item.tune))){
        rate*=Math.pow(2,Number(item.tune)/1200);
    }

    if(fxState.pitch){

        const shift=
            Number(
                $("fx_pitch_shift").value
            );

        const mix=
            Number(
                $("fx_pitch_mix").value
            );

        const shifted=
            Math.pow(
                2,
                shift/12
            );

        rate*=
            (
                1-mix+
                shifted*mix
            );
    }

    source.playbackRate.value=
        rate;
    if(source.detune){
        source.detune.value=getMicroTuneCents(note)+getPitchBendCents()+getMasterTuneCents();
    }

    source.connect(gain);
    const samplePan=Math.max(-1,Math.min(1,Number(zone.pan??0)/100));
    if(audioContext.createStereoPanner){
        const panNode=audioContext.createStereoPanner();
        panNode.pan.value=samplePan;
        gain.connect(panNode);
        panNode.connect(fxChain.performanceGain);
    }else{
        gain.connect(fxChain.performanceGain);
    }

    const voice={
        id:++voiceCounter,
        type:"wav",
        source,
        gain,
        note,
        velocity,
        baseRate:1,
        baseNominalRate:rate,
        nominalRate:rate,
        sampleNote:Number.isFinite(Number(item.sampleNote)) ? Number(item.sampleNote) : note,
        zoneRef:zone,
        zoneTuneCents:Number(zone.tune??0),
        currentNote:note,
        released:false,
        octaveSource:null,
        octaveGain:null,
        octaveShift:0,
        sampleVolumeDb:sampleDb,
        samplePan:samplePan,
        releaseSeconds:geRelease
    };

    /* REAL OCTAVE */

    if(fxState.oct){

        const octave=
            Number(
                $("fx_oct_shift").value
            );

        const mix=
            Number(
                $("fx_oct_mix").value
            );

        if(mix>0){

            const octSource=
                audioContext.createBufferSource();

            octSource.buffer=item.buffer;

            octSource.playbackRate.value=
                rate*
                Math.pow(2,octave);

            const octGain=
                audioContext.createGain();

            octGain.gain.value=
                amplitude*mix;

            octSource.connect(
                octGain
            );

            octGain.connect(
                fxChain.input
            );

            octSource.start(now,startOffset);

            voice.octaveSource=
                octSource;

            voice.octaveGain=
                octGain;
            voice.octaveShift=octave;
        }
    }

    source.onended=()=>{
        removeVoice(voice);
    };

    source.start(now,startOffset);

    return voice;
}

/* ============================================================
   STOP VOICE
============================================================ */

function stopVoice(voice){

    if(
        !voice||
        voice.released
    ){
        return;
    }

    voice.released=true;

    if(!audioContext) return;

    try{

        const now=
            audioContext.currentTime;

        // Use the release belonging to THIS sample, never the global release.
        const release=Math.max(
            .01,
            Number.isFinite(Number(voice.releaseSeconds))
                ? Number(voice.releaseSeconds)
                : Number($("release")?.value||.5)
        );

        voice.gain.gain.cancelScheduledValues(now);

        voice.gain.gain.setValueAtTime(
            Math.max(
                .0001,
                voice.gain.gain.value
            ),
            now
        );

        voice.gain.gain.exponentialRampToValueAtTime(
            .0001,
            now+release
        );

        if(voice.octaveGain){

            voice.octaveGain.gain.cancelScheduledValues(now);

            voice.octaveGain.gain.setValueAtTime(
                Math.max(
                    .0001,
                    voice.octaveGain.gain.value
                ),
                now
            );

            voice.octaveGain.gain.exponentialRampToValueAtTime(
                .0001,
                now+release
            );
        }

        voice.source.stop(
            now+release+.04
        );

        if(voice.octaveSource){

            try{

                voice.octaveSource.stop(
                    now+release+.04
                );

            }catch(e){}
        }

    }catch(e){

        try{
            voice.source.stop();
        }catch(er){}
    }
}

function stopNote(note){
    const list=activeVoices.get(note);
    if(list){
        for(const voice of [...list]) stopVoice(voice);
    }
}

function stopAllVoices(){

    noteGeneration++;
    monoTransitionToken++;
    monoCreatePromise=null;

    for(
        const voice
        of getAllVoices()
    ){

        stopVoice(voice);
    }

    activeVoices.clear();
    monoVoice=null;
    heldNotes.clear();
    noteOrder.length=0;
    noteVelocities.clear();

    updateVoiceCount();
}

/* ============================================================
   START VOICE
============================================================ */

let monoCreatePromise=null;
let noteGeneration=0;
const noteStartTokens=new Map();
function nextNoteStartToken(note){const n=Number(note);const t=(noteStartTokens.get(n)||0)+1;noteStartTokens.set(n,t);return t;}
function noteStartStillValid(note,token){const n=Number(note);return noteStartTokens.get(n)===token&&heldNotes.has(n);}

async function createProgramOrWavVoice(note,velocity,startOffset=0){
    const midiNote=Number(note);
    const vel=Number(velocity??110);

    // VISUAL MAPPING DIRECT PATH:
    // Do not rely only on activeProgramMapping. Visual Mapping can receive
    // freshly decoded File/AudioBuffer objects while its modal is open.
    // Resolve the current program's zone directly by LOW/HIGH + velocity.
    try{
        const cp=window.__DEDE_PROGRAM_API?.getCurrentProgram?.();
        const zones=Array.isArray(cp?.mapping)?cp.mapping:[];
        if(zones.length){
            const soloZones=zones.some(m=>m?.solo);
            const exactZones=zones.filter(m=>{
                const exact=Number(m.note);
                const vmin=Number(m.velMin??1), vmax=Number(m.velMax??127);
                if(!Number.isFinite(exact)||exact!==midiNote)return false;
                if(m.mute)return false;
                if(soloZones&&!m.solo)return false;
                return vel>=vmin && vel<=vmax && (m.file||m.buffer);
            });
            // A mapped note owns its own zone. Never let an overlapping range
            // cause another sample's controls to be used for this exact key.
            let hit=exactZones[0]||null;
            if(!hit) hit=zones.find(m=>{
                const low=Number(m.low??m.note);
                const high=Number(m.high??m.note);
                const vmin=Number(m.velMin??1);
                const vmax=Number(m.velMax??127);
                if(!Number.isFinite(low)||!Number.isFinite(high))return false;
                if(m.mute)return false;
                if(soloZones&&!m.solo)return false;
                return midiNote>=low && midiNote<=high && vel>=vmin && vel<=vmax && (m.file||m.buffer);
            });
            if(hit){
                const root=Number(hit.root??hit.note??midiNote);
                return await createWAVVoice(midiNote,vel,{
                    file:hit.file,
                    buffer:hit.buffer||null,
                    name:hit.name||'Visual Mapping Sample',
                    sampleNote:root,
                    tune:Number(hit.tune??((Number(hit.coarse)||0)*100+(Number(hit.fine)||0))),
                    volume:Number(hit.volume??0),
                    pan:Number(hit.pan??0),
                    attack:Number(hit.attack??0),
                    release:Number(hit.release??200),
                    velMin:Number(hit.velMin??1),
                    velMax:Number(hit.velMax??127),
                    mute:!!hit.mute,
                    solo:!!hit.solo,
                    zoneRef:hit
                },startOffset);
            }
        }
    }catch(err){
        console.warn('Visual Mapping direct audio lookup failed:',err);
    }

    // If Visual Mapping owns this program's samples, do not fall through to a stale
    // keyboard map: a moved zone must change the actual MIDI->sample relationship.
    try{
        const cp=window.__DEDE_PROGRAM_API?.getCurrentProgram?.();
        const vmOwns=Array.isArray(cp?.mapping)&&cp.mapping.some(m=>m&&(m.file||m.buffer));
        if(vmOwns)return null;
    }catch(_){}

    // Existing program/global WAV/SF2 engine remains as fallback.
    if(activeProgramMapping instanceof Map && activeProgramMapping.size){
        let item=activeProgramMapping.get(midiNote);
        let mappedNote=midiNote;
        if(!item){
            let best=null,bestDist=Infinity;
            for(const [mn,mi] of activeProgramMapping.entries()){
                const d=Math.abs(Number(mn)-midiNote);
                if(d<bestDist){bestDist=d;best={mn:Number(mn),mi};}
            }
            if(best){ item=best.mi; mappedNote=best.mn; }
        }
        if(item)return await createWAVVoice(midiNote,vel,{...item,sampleNote:mappedNote},startOffset);
    }
    if(soundFont){
        const usablePresets=soundFont.presets.filter(p=>p.name&&p.name!=="EOP");
        const preset=usablePresets[selectedPreset];
        if(preset){
            const zones=soundFont.findZones(preset,midiNote,vel);
            if(zones.length){
                const voices=[];
                for(const z of zones){
                    const v=await createSF2Voice(midiNote,vel,z);
                    if(v)voices.push(v);
                }
                return voices.length===1?voices[0]:voices;
            }
        }
    }
    if(wavMapping.has(midiNote))return await createWAVVoice(midiNote,vel,wavMapping.get(midiNote),0);
    return null;
}

function normalizeVoiceResult(result){
    if(!result) return [];
    return Array.isArray(result) ? result.filter(Boolean) : [result];
}

async function transitionMonoToNote(targetNote, velocity=110, allowGlide=true, isReturn=false){
    const target=Number(targetNote);
    if(!Number.isFinite(target)) return false;
    if(!monoVoice || monoVoice.released) return false;
    const from=Number(monoVoice.currentNote ?? monoVoice.note ?? target);
    if(target===from) return true;

    const token=++monoTransitionToken;
    const oldGroup=monoVoice.monoGroup||[monoVoice];

    try{
        /*
          FINGERED / KRONOS-STYLE SAMPLED LEGATO
          ---------------------------------------
          The important rule here is: never pitch-bend the old note into the
          new note. The new key gets its own mapped sample. We enter that sample
          AFTER its attack/transient and overlap it with the currently sounding
          sample so there is no audible hole.
        */
        const currentPerf=performanceEnabled();
        // PORTAMENTO is the sole gate for pitch glide.
        // MONO or LEGATO by themselves must never glide.
        const doGlide=!!allowGlide && !!currentPerf.portamento;
        const targetOffsetBase=isReturn ? 0.065 : 0.090;
        let targetOffset=targetOffsetBase;
        try{
            const mapped=await createProgramOrWavVoice(target,velocity,targetOffsetBase);
            const testVoices=normalizeVoiceResult(mapped);
            if(!testVoices.length) return false;

            const latest=noteOrder[noteOrder.length-1];
            if(token!==monoTransitionToken || !heldNotes.has(target) || latest!==target){
                testVoices.forEach(v=>{try{stopVoice(v)}catch(e){}});
                return false;
            }

            /*
              Soft no-gap crossfade. The target starts from inside the sample,
              so the new note does not reproduce its hard attack. Both voices
              overlap briefly; this is the critical part that removes the gap.
            */
            testVoices.forEach(v=>addVoice(v));

            const now=audioContext.currentTime;
            const crossfade=Math.max(0.095, targetOffsetBase + 0.005); // Shorter release while keeping enough overlap to prevent a gap
            const targetLevel=Math.max(.0002,(velocity/127)*Math.max(.01,modulationVolume||1));

            for(const v of testVoices){
                v.currentNote=target;
                v.nominalRate=Math.max(.01,Number(v.nominalRate||v.baseNominalRate||1));
                v.velocity=velocity;
                try{
                    const gp=v.gain.gain;
                    gp.cancelScheduledValues(now);
                    gp.setValueAtTime(.0001,now);
                    gp.linearRampToValueAtTime(targetLevel,now+crossfade);

                    /* GLIDE ONLY: keep the existing sampled-legato exactly as-is,
                       but slide the TARGET sample in a single straight ramp from
                       the previous note pitch to the target pitch. */
                    if(v.source?.playbackRate){
                        const targetRate=Math.max(.01,Number(v.nominalRate||v.baseNominalRate||1));
                        const glideSeconds=doGlide ? getGlideSeconds() : 0;
                        const startRate=glideSeconds>0
                            ? Math.max(.01,getVoiceTargetRate(v,from))
                            : targetRate;
                        const rp=v.source.playbackRate;
                        rp.cancelScheduledValues(now);
                        rp.setValueAtTime(startRate,now);
                        if(glideSeconds>0){
                            rp.linearRampToValueAtTime(targetRate,now+glideSeconds);
                            v.glideActive=true;
                            v.glideMs=Math.round(glideSeconds*1000);
                            v.glideStartedAt=now;
                            v.glideDuration=glideSeconds;
                            v.portamentoTargetRate=targetRate;
                        }else{
                            v.glideActive=false;
                            v.glideMs=0;
                        }
                    }
                    if(v.source?.detune){
                        v.source.detune.cancelScheduledValues(now);
                        // Per-zone Micro Tune is already baked into the target
                        // sample playbackRate. Detune here is only pitch-bend/master.
                        v.source.detune.setValueAtTime(
                            getMicroTuneCents(v.currentNote??v.note)+getPitchBendCents()+getMasterTuneCents(),now
                        );
                    }
                    if(v.octaveSource){
                        const oct=Math.pow(2,Number(v.octaveShift||0));
                        const octaveTarget=Math.max(.01,v.nominalRate*oct);
                        const glideSeconds=allowGlide ? getGlideSeconds() : 0;
                        const octaveStart=glideSeconds>0
                            ? Math.max(.01,getVoiceTargetRate(v,from)*oct)
                            : octaveTarget;
                        v.octaveSource.playbackRate.cancelScheduledValues(now);
                        v.octaveSource.playbackRate.setValueAtTime(octaveStart,now);
                        if(glideSeconds>0){
                            v.octaveSource.playbackRate.linearRampToValueAtTime(octaveTarget,now+glideSeconds);
                            v.octavePortamentoTargetRate=octaveTarget;
                        }
                        if(v.octaveSource.detune){
                            v.octaveSource.detune.cancelScheduledValues(now);
                            v.octaveSource.detune.setValueAtTime(
                                getMicroTuneCents(v.currentNote??v.note)+getPitchBendCents()+getMasterTuneCents(),now
                            );
                        }
                    }
                }catch(e){ console.warn('legato target setup',e); }
            }

            /* Keep the old note alive until the target sample is audible, then
               release it. This avoids the gap and avoids a hard attack edge. */
            for(const old of oldGroup){
                if(!old || old.released) continue;
                try{
                    const t=audioContext.currentTime;
                    old.released=true;
                    const gp=old.gain.gain;
                    const oldLevel=Math.max(.0001,Number(gp.value)||.0001);
                    gp.cancelScheduledValues(t);
                    gp.setValueAtTime(oldLevel,t);
                    gp.linearRampToValueAtTime(.0001,t+crossfade);
                    try{old.source?.stop(t+crossfade+.01)}catch(e){}
                    try{old.octaveSource?.stop(t+crossfade+.01)}catch(e){}
                }catch(e){ console.warn('legato old voice release',e); }
            }

            monoVoice=testVoices[0];
            monoVoice.monoGroup=testVoices;
            testVoices.slice(1).forEach(v=>v.monoGroup=testVoices);
            monoVoice.currentNote=target;
            monoVoice.velocity=velocity;
            monoVoice.glideActive=false;
            monoVoice.glideMs=0;
            updatePerformanceStatusSafe?.();
            animateMeter();
            return true;
        }catch(e){
            console.warn('legato transition target sample',e);
            return false;
        }
    }catch(e){
        console.warn('transitionMonoToNote failed',e);
        return false;
    }
}

async function startVoice(note,velocity=110){
    try{
        await initializeAudio();
        const perf=performanceEnabled();

        // Track the physical key stack and its velocity. This is essential for
        // true mono/legato return: when the top note is released we know exactly
        // which still-held note must become the target again.
        if(!heldNotes.has(note)) heldNotes.add(note);
        noteVelocities.set(note,velocity);
        const oldIndex=noteOrder.indexOf(note);
        if(oldIndex!==-1) noteOrder.splice(oldIndex,1);
        noteOrder.push(note);

        if(perf.mono){
            const target=noteOrder[noteOrder.length-1];

            if(monoVoice && !monoVoice.released){
                const current=Number(monoVoice.currentNote ?? monoVoice.note ?? target);
                if(target!==current){
                    // A real sampled-legato transition: load the TARGET sample,
                    // begin it at the old pitch, glide to the target pitch, then
                    // fade the old sample out. Never retune the wrong sample back
                    // when a held note is released.
                    await transitionMonoToNote(target,velocity,perf.portamento);
                }
                return;
            }

            if(monoCreatePromise){
                await monoCreatePromise;
                if(monoVoice && !monoVoice.released){
                    const latest=noteOrder[noteOrder.length-1];
                    if(Number.isFinite(latest) && latest!==Number(monoVoice.currentNote ?? monoVoice.note)){
                        await transitionMonoToNote(latest,noteVelocities.get(latest)||110,perf.portamento);
                    }
                }
                return;
            }

            const createFor=target;
            monoCreatePromise=(async()=>{
                const result=await createProgramOrWavVoice(createFor,velocity);
                const voices=normalizeVoiceResult(result);
                if(!voices.length) return;

                // If the user changed notes while the async sample was loading,
                // the newest held note wins immediately after creation.
                voices.forEach(v=>addVoice(v));
                monoVoice=voices[0];
                monoVoice.monoGroup=voices;
                voices.slice(1).forEach(v=>v.monoGroup=voices);

                const latest=noteOrder[noteOrder.length-1];
                if(Number.isFinite(latest) && latest!==createFor){
                    // transitionMonoToNote handles the target-sample swap and
                    // cancels the stale initial note without corrupting pitch.
                    await transitionMonoToNote(latest,noteVelocities.get(latest)||110,perf.portamento);
                }
                animateMeter();
            })();
            try{ await monoCreatePromise; } finally { monoCreatePromise=null; }
            return;
        }

        // LEGATO only: first key starts normally; a second held key transitions
        // through the target sample without retriggering its hard attack.
        if(perf.legato){
            if(monoVoice && !monoVoice.released && noteOrder.length>1){
                const current=Number(monoVoice.currentNote ?? monoVoice.note ?? note);
                if(note!==current){
                    await transitionMonoToNote(note,velocity,perf.portamento,false);
                }
                return;
            }

            const result=await createProgramOrWavVoice(note,velocity);
            const voices=normalizeVoiceResult(result);
            if(!voices.length) return;
            voices.forEach(v=>addVoice(v));
            monoVoice=voices[0]||null;
            if(monoVoice){
                monoVoice.monoGroup=voices;
                voices.slice(1).forEach(v=>v.monoGroup=voices);
            }
            animateMeter();
            return;
        }

        // POLY / NORMAL mode.
        const result=await createProgramOrWavVoice(note,velocity);
        const voices=normalizeVoiceResult(result);
        voices.forEach(v=>addVoice(v));
        animateMeter();
    }catch(error){
        console.error(error);
    }
}

function retuneMonoGroup(group,targetNote,glide){
    if(!group) return;
    for(const v of group){
        if(v && !v.released) retuneVoice(v,targetNote,glide);
    }
}

function releaseNote(note){
    if(!heldNotes.has(note)) return;

    const idx=noteOrder.lastIndexOf(note);
    if(idx!==-1) noteOrder.splice(idx,1);
    heldNotes.delete(note);
    noteVelocities.delete(note);

    const perf=performanceEnabled();

    if(perf.mono || perf.legato){
        // In a real mono/legato stack, only the currently sounding note owns
        // the voice. Releasing an older held key must NOT retune the current
        // sample. Releasing the current top note selects the previous held
        // note and performs a proper target-sample transition.
        const current=monoVoice && !monoVoice.released
            ? Number(monoVoice.currentNote ?? monoVoice.note)
            : null;

        if(noteOrder.length){
            const target=noteOrder[noteOrder.length-1];
            if(current!==null && target!==current){
                monoTransitionToken++;
                transitionMonoToNote(target,noteVelocities.get(target)||110,perf.portamento,true);
            }
            return;
        }

        monoTransitionToken++;
        if(monoVoice){
            const group=monoVoice.monoGroup||[monoVoice];
            group.forEach(v=>stopVoice(v));
            monoVoice=null;
        }
        return;
    }

    stopNote(note);
}

/* ============================================================
   METER
============================================================ */

function animateMeter(){

    if(meterFrame){
        cancelAnimationFrame(
            meterFrame
        );
    }

    let strength=100;

    function frame(){

        strength*=.91;

        $("meterFill")
            .style
            .width=
            Math.max(
                0,
                strength
            )+"%";

        if(strength<2){

            $("meterFill")
                .style
                .width="0%";

            meterFrame=null;
            return;
        }

        meterFrame=
            requestAnimationFrame(
                frame
            );
    }

    frame();
}

