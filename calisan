<script id="ds-fx-explorer-script">
(()=>{
  const $=id=>document.getElementById(id);
  const legacy=document.querySelector('.dsFxLegacy');
  const home=$('dsFxHomeView'), sub=$('dsFxSubView'), settings=$('dsFxSettingsView'), mount=$('dsFxSettingsMount'), path=$('dsFxPath'), back=$('dsFxBack');
  if(!legacy||!home||!sub||!settings||!mount||!path||!back) return;
  if(window.__DEDE_FX_ROUTER_READY) return;
  window.__DEDE_FX_ROUTER_READY=true;

  const cats=[
    ['dynamics','⚡','DYNAMICS','Gate • Compressor • Limiter','#ff9b54','3'],
    ['drive','◉','DRIVE & AMP','Overdrive • Amp • Tone','#ff5f67','3'],
    ['cabeq','▦','CAB & EQ','Cabinet • EQ • Filter','#e6c35a','3'],
    ['pitchmod','∿','PITCH & MOD','Octaver • Pitch • Chorus • Wah','#69e8a1','4'],
    ['delay','◌','DELAY','Digital • Analog • Tape • Ping Pong','#63c9ff','7'],
    ['reverb','✦','REVERB','Room • Chamber • Plate • Hall • Shimmer','#c995ff','6'],
    ['space','◈','STEREO','Stereo Width','#72e7ff','1'],
    ['presets','★','PRESETS','300 Factory FX chains • Instant sounds','#d9b45d','300']
  ];
  const descriptions={
    dynamics:'Dinamik kontrol ve seviye şekillendirme',
    drive:'Drive, amp karakteri ve ton',
    cabeq:'Cabinet, equalizer ve filter',
    pitchmod:'Pitch, modulation ve wah',
    delay:'Zaman tabanlı echo ve ritmik tekrarlar',
    reverb:'Mekân, plate ve atmosfer reverbleri',
    space:'Stereo genişlik ve uzaysal görüntü',
    presets:'Hazır profesyonel FX zincirleri ve özel ses karakterleri'
  };
  const titleMap={
    dynamics:['NOISE GATE','COMPRESSOR','LIMITER'],
    drive:['OVERDRIVE / DIST','AMP SIMULATOR','AMP TONE'],
    cabeq:['CABINET SIM','PARAMETRIC EQ','FILTER'],
    pitchmod:['OCTAVER','PITCH SHIFT','CHORUS / FLANGER','AUTO WAH'],
    space:['STEREO WIDENER']
  };
  const dedeFactoryPresets=window.dedeFactoryPresets||[];

  const show=view=>{
    home.hidden=view!=='home';
    sub.hidden=view!=='sub';
    settings.hidden=view!=='settings';
  };
  const setPath=t=>{path.textContent=t;};
  const category=cat=>cats.find(x=>x[0]===cat);
  const card=cat=>`<div class="dsFxCard${cat[0]==='presets'?' dsFxPresetCard':''}" data-cat="${cat[0]}" style="--c:${cat[4]}"><span class="dsFxCount">${cat[5]} FX</span><div class="dsFxIcon">${cat[1]}</div><h3>${cat[2]}</h3><p>${descriptions[cat[0]]}</p></div>`;
  const presetCard=item=>`<div class="dsFxPresetItem" data-preset="${item[0]}" title="Tek tık: preset uygula"><span class="dsFxPresetState"></span><div class="dsFxPresetNum">${String(dedeFactoryPresets.indexOf(item)+1).padStart(3,'0')}</div><strong class="dsFxPresetName">${item[1]}</strong><span class="dsFxPresetDesc">${item[2]}</span><span class="dsFxPresetFx">${item[3]}</span></div>`;

  home.innerHTML=cats.map(card).join('');

  // Remember each module's original parent so leaving/re-entering an effect never
  // destroys the legacy rack structure. The module itself is moved only while open.
  const moduleHome=new Map();
  ['dynamics','drive','cabeq','pitchmod','delay','reverb','space'].forEach(cat=>{
    const tab=$('fxTab-'+cat); if(!tab) return;
    tab.querySelectorAll('.fxModule').forEach((mod,i)=>{
      moduleHome.set(mod,{parent:tab,next:mod.nextSibling,index:i,cat});
    });
  });

  const getModule=(cat,index=0)=>{
    const tab=$('fxTab-'+cat); if(!tab)return null;
    // Query the current DOM because a module can be temporarily mounted in settings.
    const mods=[...tab.querySelectorAll(':scope > .fxModule')];
    return mods[index]||null;
  };

  const restoreModule=()=>{
    const mod=mount.querySelector('.fxModule');
    if(!mod)return;
    const rec=moduleHome.get(mod);
    if(rec?.parent){
      if(rec.next && rec.next.parentNode===rec.parent) rec.parent.insertBefore(mod,rec.next);
      else rec.parent.appendChild(mod);
    }
    mod.style.display='';
  };

  const openCategory=cat=>{
    const c=category(cat); if(!c)return;
    setPath('FX HOME  /  '+c[2]);
    sub.innerHTML='';
    if(cat==='presets'){
      const list=dedeFactoryPresets.length?dedeFactoryPresets.map(presetCard).join(''):'<div style="color:#77828b;padding:20px">Preset listesi hazır değil.</div>';
      sub.innerHTML=`<div class="dsFxPresetTop"><button type="button" class="dsFxPresetBack" id="dsFxPresetBack">← FX LIBRARY</button><div class="dsFxPresetNotice">300 FACTORY PRESETS • TIKLA VE UYGULA • FX zinciri ve parametreleri birlikte yüklenir.</div></div><div class="dsFxPresetGrid">${list}</div>`;
      $('dsFxPresetBack')?.addEventListener('click',()=>{show('home');setPath('FX HOME');});
      show('sub');
      return;
    }
    if(cat==='delay'||cat==='reverb'){
      const modes=cat==='delay'?
        [['digital','DIGITAL','Clean studio delay'],['analog','ANALOG','Warm filtered repeats'],['tape','TAPE ECHO','Wow, flutter & saturation'],['pingpong','PING PONG','Wide left-right repeats'],['stereo','STEREO','Dual stereo delay'],['slapback','SLAPBACK','Short classic echo'],['dotted8','DOTTED 1/8','Tempo dotted rhythm']]:
        [['room','ROOM','Small natural space'],['chamber','CHAMBER','Warm acoustic chamber'],['plate','PLATE','Bright dense plate'],['hall','HALL','Large natural hall'],['cathedral','CATHEDRAL','Long cinematic space'],['shimmer','SHIMMER','Airy high-frequency tail']];
      sub.innerHTML=modes.map(m=>`<div class="dsFxSubCard" data-cat="${cat}" data-mode="${m[0]}" style="--c:${c[4]}"><strong><i class="dot"></i>${m[1]}</strong><span>${m[2]}</span></div>`).join('');
    }else{
      sub.innerHTML=(titleMap[cat]||[]).map((t,i)=>`<div class="dsFxSubCard" data-cat="${cat}" data-index="${i}" style="--c:${c[4]}"><strong><i class="dot"></i>${t}</strong><span>Efekt ayarlarını aç</span></div>`).join('');
    }
    sub.insertAdjacentHTML('afterbegin','<div class="dsFxSubBackBar"><button type="button" class="dsFxSubBack" id="dsFxSubBack">← FX HOME</button></div>');
    $('dsFxSubBack')?.addEventListener('click',()=>{show('home');setPath('FX HOME');});
    show('sub');
  };

  const openEffect=(cat,index=0,mode=null)=>{
    const c=category(cat); if(!c)return;
    const mod=getModule(cat,index);
    if(!mod){
      console.warn('[DEDE FX] Module bulunamadı:',cat,index);
      return;
    }
    const select=mode && (cat==='delay'?mod.querySelector('#fx_del_type'):cat==='reverb'?mod.querySelector('#fx_rev_type'):null);
    if(select && select.value!==mode){
      select.value=mode;
      select.dispatchEvent(new Event('change',{bubbles:true}));
    }
    // Restore from any previous accidental mount before opening another module.
    if(mount.querySelector('.fxModule') && mount.querySelector('.fxModule')!==mod) restoreModule();
    mount.innerHTML='';
    mount.appendChild(mod);
    mod.style.display='block';
    const label=(mode||titleMap[cat]?.[index]||'EFFECT').toUpperCase();
    setPath('FX HOME  /  '+c[2]+'  /  '+label);
    $('dsFxSettingsCat').textContent=c[2];
    $('dsFxSettingsTitle').textContent=label;
    const toggle=mod.querySelector('.fxToggle');
    $('dsFxPowerDot').classList.toggle('on',!!toggle&&toggle.classList.contains('on'));
    if(toggle && !toggle.dataset.dedePowerWatch){
      toggle.dataset.dedePowerWatch='1';
      new MutationObserver(()=>$('dsFxPowerDot').classList.toggle('on',toggle.classList.contains('on'))).observe(toggle,{attributes:true,attributeFilter:['class']});
    }
    show('settings');
    // Ensure controls remain live after being moved into the settings view.
    mod.querySelectorAll('input,select').forEach(el=>{
      if(el.dataset.dedeExplorerWire==='1')return;
      el.dataset.dedeExplorerWire='1';
      el.addEventListener('input',()=>{try{if(typeof updateFx==='function')updateFx()}catch(_){}},{passive:true});
      el.addEventListener('change',()=>{try{if(typeof updateFx==='function')updateFx()}catch(_){}},{passive:true});
    });
    try{if(typeof updateFx==='function')updateFx()}catch(e){console.warn('[DEDE FX] updateFx',e)}
  };

  home.addEventListener('click',e=>{
    const x=e.target.closest?.('.dsFxCard');
    if(!x)return;
    e.preventDefault();
    openCategory(x.dataset.cat);
  });
  sub.addEventListener('click',e=>{
    const backBtn=e.target.closest?.('.dsFxSubBack,.dsFxPresetBack');
    if(backBtn)return;
    const x=e.target.closest?.('.dsFxSubCard');
    if(x){e.preventDefault();openEffect(x.dataset.cat,Number(x.dataset.index||0),x.dataset.mode||null);return;}
    const p=e.target.closest?.('.dsFxPresetItem');
    if(p){try{if(typeof applyFactoryPreset==='function')applyFactoryPreset(p.dataset.preset)}catch(err){console.warn(err)}sub.querySelectorAll('.dsFxPresetItem').forEach(a=>a.classList.remove('active'));p.classList.add('active');setPath('FX HOME  /  PRESETS  /  '+(p.querySelector('.dsFxPresetName')?.textContent||''));}
  });
  back.addEventListener('click',e=>{
    e.preventDefault();
    restoreModule();
    show('sub');
    const parts=(path.textContent||'').split(' / ');
    setPath('FX HOME  /  '+(parts[1]||'FX'));
  });

  // Prevent the legacy rack's tab buttons from hijacking the explorer. The old
  // rack remains the DSP source, but its navigation is no longer user-facing.
  document.addEventListener('click',e=>{
    const b=e.target.closest?.('#fxStudioModal .dsFxLegacy .fxTabBtn[data-tab]');
    if(!b)return;
    if(document.querySelector('.dsFxExplorer')?.contains(e.target))return;
    e.preventDefault();
    e.stopImmediatePropagation();
  },true);

  show('home');
  setPath('FX HOME');
})();
</script>

<script id="dede-fx-fix-v971">
(()=>{
  /* ------------------------------------------------------------
     V9.7.1 FX ENGINE FIXES
     - Real tremolo modulation
     - Real ping-pong movement
     - Real stereo widening branch
     - Safe live updates after controls are moved into the explorer
     ------------------------------------------------------------ */
  const addFix=async()=>{
    if(typeof initializeAudio!=="function") return;
    // Audio nodes are created lazily inside initializeAudio. We patch the
    // initializer once so the extra nodes are available after first audio start.
    const originalInit=initializeAudio;
    if(originalInit.__dede971) return;
    const patchedInit=async function(){
      const result=await originalInit();
      if(audioContext && !fxChain.modTremoloGain){
        fxChain.modTremoloGain=audioContext.createGain();
        fxChain.modTremoloLFO=audioContext.createOscillator();
        fxChain.modTremoloDepth=audioContext.createGain();
        fxChain.modTremoloLFO.frequency.value=5;
        fxChain.modTremoloGain.gain.value=1;
        fxChain.modTremoloDepth.gain.value=0;
        fxChain.modLFO.disconnect(fxChain.modDepth);
        fxChain.modLFO.connect(fxChain.modDepth);
        fxChain.modTremoloLFO.connect(fxChain.modTremoloDepth);
        fxChain.modTremoloDepth.connect(fxChain.modTremoloGain.gain);
        try{fxChain.modDelay.disconnect(fxChain.modWet)}catch(e){}
        fxChain.modDelay.connect(fxChain.modTremoloGain);
        fxChain.modTremoloGain.connect(fxChain.modWet);
        fxChain.modTremoloLFO.start();

        fxChain.delayPanDepth=audioContext.createGain();
        fxChain.delayPanDepth.gain.value=0;
        fxChain.delayLFO.connect(fxChain.delayPanDepth);
        fxChain.delayPanDepth.connect(fxChain.delayPan.pan);

        fxChain.wideDelay=audioContext.createDelay(.06);
        fxChain.widePan=audioContext.createStereoPanner();
        fxChain.wideWet=audioContext.createGain();
        fxChain.stereo.connect(fxChain.wideDelay);
        fxChain.wideDelay.connect(fxChain.widePan);
        fxChain.widePan.connect(fxChain.wideWet);
        fxChain.wideWet.connect(fxChain.master);
        fxChain.wideWet.gain.value=0;
      }
      return result;
    };
    patchedInit.__dede971=true;
    initializeAudio=patchedInit;
  };
  addFix();

  const realUpdate=updateFx;
  updateFx=function(){
    realUpdate();
    if(!audioContext || !fxChain.modTremoloGain) return;

    const modOn=!!fxState.mod;
    const type=document.getElementById('fx_mod_type')?.value||'chorus';
    const depth=Number(document.getElementById('fx_mod_depth')?.value||0);

    fxChain.modTremoloGain.gain.value=1;
    fxChain.modTremoloDepth.gain.value=0;
    fxChain.modTremoloLFO.frequency.value=type==='tremolo'?5:1.2;
    if(type==='tremolo' && modOn){
      // LFO output (-1..1) scaled around unity: 1 +/- depth*0.75.
      fxChain.modTremoloGain.gain.value=1-depth*.375;
      fxChain.modTremoloDepth.gain.value=depth*.375;
      fxChain.modWet.gain.value=Math.max(.75,depth);
    }

    const delayType=document.getElementById('fx_del_type')?.value||'digital';
    const delayWidth=Number(document.getElementById('fx_del_width')?.value||0);
    if(fxState.del && delayType==='pingpong'){
      fxChain.delayPanDepth.gain.value=Math.min(1,Math.max(0,delayWidth));
      fxChain.delayPan.pan.value=0;
    }else{
      fxChain.delayPanDepth.gain.value=0;
      fxChain.delayPan.pan.value=0;
    }

    const wideOn=!!fxState.wide;
    const width=Number(document.getElementById('fx_wide_amount')?.value||0);
    if(fxChain.wideWet){
      fxChain.wideWet.gain.value=wideOn ? Math.min(.7,width*.7) : 0;
      fxChain.wideDelay.delayTime.value=.012+width*.042;
      fxChain.widePan.pan.value=wideOn ? Math.min(.95,width) : 0;
    }
  };

  // Re-attach live listeners because the FX explorer moves modules in the DOM.
  const wire=()=>document.querySelectorAll('#fxStudioModal input,#fxStudioModal select').forEach(el=>{
    if(el.dataset.dede971Wire==='1') return;
    el.dataset.dede971Wire='1';
    el.addEventListener('input',()=>updateFx());
    el.addEventListener('change',()=>updateFx());
  });
  const obs=new MutationObserver(()=>requestAnimationFrame(wire));
  const root=document.getElementById('fxStudioModal');
  if(root) obs.observe(root,{childList:true,subtree:true});
  wire();

  // Ensure the replacement update function is used by the controls created later.
  window.setTimeout(()=>{try{wire();updateFx()}catch(e){console.warn('FX 9.7.1',e)}},250);
})();
</script>

<script id="general-edit-modal-controller">
(()=>{
  const modal=document.getElementById('generalEditModal');
  const openBtn=document.getElementById('openGeneralEdit');
  const closeBtn=document.getElementById('closeGeneralEdit');
  const mount=document.getElementById('generalEditMount');
  const lower=document.querySelector('.lower');
  const led=document.getElementById('generalEditLed');
  if(!modal||!openBtn||!closeBtn||!mount||!lower) return;

  // Move the EXISTING three performance panels into the modal.
  // Their IDs remain untouched, so the existing Filter/Master, Envelope,
  // Legato, Portamento, Glide and Pitch Bend code continues to target them.
  const panels=[...lower.querySelectorAll(':scope > .performance')];
  panels.forEach(panel=>mount.appendChild(panel));

  const syncLed=()=>{
    if(led){
      const anyOn=['legato','portamento','mono'].some(id=>document.getElementById(id)?.classList.contains('on'));
      led.classList.toggle('active',anyOn);
    }
  };
  const open=()=>{
    modal.classList.add('open');
    modal.setAttribute('aria-hidden','false');
    document.body.classList.add('fxStudioLocked');
    syncLed();
  };
  const close=()=>{
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden','true');
    if(!document.getElementById('fxStudioModal')?.classList.contains('open')) document.body.classList.remove('fxStudioLocked');
  };
  openBtn.addEventListener('click',open);
  closeBtn.addEventListener('click',close);
  modal.addEventListener('click',e=>{if(e.target===modal)close();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape' && modal.classList.contains('open')) close();});
  ['legato','portamento','mono'].forEach(id=>document.getElementById(id)?.addEventListener('click',()=>setTimeout(syncLed,0)));
  syncLed();
})();
</script>
<script id="loop-studio-script">
(()=>{
  const $=id=>document.getElementById(id);
  const modal=$('loopStudioModal'), openBtn=$('openLoopStudio'), closeBtn=$('closeLoopStudio');
  if(!modal||!openBtn||!closeBtn)return;
  const cats=[
    ['all','◈','TÜM LOOPS','#69ddec'],['fav','★','FAVORİLER','#ffd66b'],['roman','🥁','ROMAN HAVASI','#ff7bc9'],['misket','💃','MİSKET','#ffb45e'],['ankara','🪕','ANKARA','#a8e66a'],['halay','🎻','HALAY','#8bbcff'],['zeybek','🪗','ZEYBEK','#c89cff'],['folk','🥁','7/8 • 9/8','#ff8e8e'],['pop','🎹','POP / ARABESK','#62d8ff'],['other','📁','DİĞER','#b7c4c8']
  ];
  const state={items:[],cat:'all',selected:null,playing:null,favs:new Set(),source:null,stretcher:null};
  let ctx=null, gain=null, source=null;
  function color(c){return c.replace('#','')}
  function open(){modal.classList.add('open');modal.setAttribute('aria-hidden','false');document.body.classList.add('fxStudioLocked');renderCats();render();}
  function close(){stop();modal.classList.remove('open');modal.setAttribute('aria-hidden','true');document.body.classList.remove('fxStudioLocked');}
  openBtn.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();open()}); closeBtn.addEventListener('click',close); modal.addEventListener('click',e=>{if(e.target===modal)close()}); window.addEventListener('dede:ncw-decoded',async e=>{const f=e.detail?.file;if(!f)return;try{const note=Number(e.detail?.note??48);if(!wavFiles.length){const oldStart=$("startNote")?.value;if($("startNote"))$("startNote").value=String(note);await buildWavMapping([f]);if($("startNote"))$("startNote").value=oldStart??"48";}else{const item=await loadWavFile(f);wavFiles.push(item);wavMapping.set(note,item);renderMapping();}status.innerHTML='<span class="nkiOk">NCW DEDE SOUND motoruna eklendi.</span> '+f.name+' → MIDI '+note+'.';}catch(err){status.innerHTML='<span class="nkiWarn">NCW motoruna eklenemedi: '+String(err).replace(/</g,'&lt;')+'</span>';}});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close()});
  $('loopLoadFiles').addEventListener('click',()=> $('loopFiles').click()); $('loopLoadFolder').addEventListener('click',()=> $('loopFolder').click());
  $('loopFiles').addEventListener('change',e=>loadFiles([...e.target.files])); $('loopFolder').addEventListener('change',e=>loadFiles([...e.target.files]));
  $('loopSearch').addEventListener('input',render); $('loopBpm').addEventListener('input',()=>{$('loopTempoInfo').textContent=($('loopBpm').value||96)+' BPM'; if(state.playing)restartSelected()}); $('loopVolume').addEventListener('input',()=>{if(gain)gain.gain.value=+$('loopVolume').value}); $('loopPitchLock').addEventListener('change',()=>{if(state.playing)restartSelected()});
  $('loopStart').addEventListener('click',()=>{if(state.selected)playItem(state.selected);else if(state.items[0]){state.selected=state.items[0];render();playItem(state.selected)}}); $('loopStop').addEventListener('click',stop); $('loopRestart').addEventListener('click',()=>{if(state.selected)playItem(state.selected)});
  function renderCats(){const box=$('loopCategories');box.innerHTML=cats.map(c=>{const active=state.cat===c[0];const count=c[0]==='all'?state.items.length:c[0]==='fav'?state.favs.size:state.items.filter(x=>x.cat===c[0]).length;return `<button class="loopCat ${active?'active':''}" style="--lc:${c[3]};--lcg:${hex(c[3],.16)}" data-cat="${c[0]}">${c[1]} ${c[2]}<small>${count} LOOP</small></button>`}).join('');box.querySelectorAll('.loopCat').forEach(b=>b.addEventListener('click',()=>{state.cat=b.dataset.cat;renderCats();render()}))}
  function hex(h,a){let x=h.replace('#','');if(x.length===3)x=x.split('').map(v=>v+v).join('');return '#'+x+a.toString(16).padStart(2,'0')}
  function render(){const q=$('loopSearch').value.trim().toLowerCase();let arr=state.items.filter(x=>{const cat=state.cat;const okCat=cat==='all'||(cat==='fav'&&state.favs.has(x.id))||x.cat===cat;return okCat&&(!q||x.name.toLowerCase().includes(q))});$('loopArchiveTitle').textContent=(cats.find(c=>c[0]===state.cat)||cats[0])[2];$('loopCount').textContent=arr.length+' LOOP';$('loopEmpty').style.display=arr.length?'none':'block';$('loopGrid').innerHTML=arr.map(x=>card(x)).join('');$('loopGrid').querySelectorAll('.loopCard').forEach(el=>{el.addEventListener('click',()=>{const item=state.items.find(x=>x.id===el.dataset.id);state.selected=item;render();playItem(item)});const f=el.querySelector('.loopFav');f.addEventListener('click',e=>{e.stopPropagation();state.favs.has(x.id)?state.favs.delete(x.id):state.favs.add(x.id);renderCats();render()})})}
  function card(x){const c=cats.find(c=>c[0]===x.cat)||cats[0], active=state.selected&&state.selected.id===x.id;return `<div class="loopCard ${active?'selected':''}" data-id="${x.id}" style="--lc:${c[3]};--lcg:${hex(c[3],.18)}"><div class="loopCardTop"><span class="loopCardTag">${c[2]}</span><span class="loopFav ${state.favs.has(x.id)?'active':''}">★</span></div><div class="loopCardName" title="${x.name}">${x.name}</div><div class="loopCardMeta"><span>${x.bpm||96} BPM</span><span>${x.ext||'AUDIO'}</span></div><button class="loopCardPlay" type="button">▶ ${active&&state.playing?'PLAYING':'SELECT / PLAY'}</button></div>`}
  async function loadFiles(files){for(const file of files){if(!file.type.startsWith('audio/')&&!/\.(wav|mp3|ogg|m4a|aac|flac)$/i.test(file.name))continue;try{const buf=await decode(file);const name=file.name.replace(/\.[^.]+$/,'').replace(/[_-]+/g,' ');state.items.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),name,bpm:detectBpm(name),cat:guessCat(name),ext:(file.name.split('.').pop()||'AUDIO').toUpperCase(),buffer:buf,originalBpm:detectBpm(name)})}catch(err){console.warn('Loop yüklenemedi',file.name,err)}}renderCats();render()}
  function detectBpm(n){const m=n.match(/(?:^|[^0-9])(\d{2,3})\s*bpm/i);return m?Math.max(40,Math.min(220,+m[1])):96}
