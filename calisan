const glideControl=$("glide");
if(glideControl){
    const syncGlideUI=()=>{
        const ms=getGlideMs();
        const out=$("glideValue");
        if(out) out.textContent=ms+" MS";
        glideControl.setAttribute("aria-valuenow",String(ms));
        glideControl.title="Portamento / Glide: "+ms+" ms";
        updatePerformanceStatusSafe();
    };
    glideControl.addEventListener("input",()=>{ syncGlideUI(); retimeActivePortamento(); });
    glideControl.addEventListener("change",syncGlideUI);
    syncGlideUI();
}

function retimeActivePortamento(){
    if(!audioContext) return;
    const perf=performanceEnabled();
    if(!perf.portamento) return;
    const now=audioContext.currentTime;
    const duration=getGlideSeconds();
    const voices=getAllVoices();
    for(const v of voices){
        if(!v || v.released || !v.glideStartedAt || !v.portamentoTargetRate || !v.source?.playbackRate) continue;
        const elapsed=Math.max(0,now-v.glideStartedAt);
        const oldDuration=Math.max(.001,Number(v.glideDuration)||.001);
        const progress=Math.min(1,elapsed/oldDuration);
        if(progress>=1) continue;
        const param=v.source.playbackRate;
        const current=Math.max(.01,Number(param.value)||.01);
        const remaining=Math.max(.001,duration*(1-progress));
        param.cancelScheduledValues(now);
        param.setValueAtTime(current,now);
        scheduleNaturalGlide(param,current,v.portamentoTargetRate,remaining,getGlideMode());
        v.glideStartedAt=now;
        v.glideDuration=remaining;
        if(v.octaveSource?.playbackRate && v.octavePortamentoTargetRate){
            const op=v.octaveSource.playbackRate;
            const oc=Math.max(.01,Number(op.value)||.01);
            op.cancelScheduledValues(now);
            op.setValueAtTime(oc,now);
            scheduleNaturalGlide(op,oc,v.octavePortamentoTargetRate,remaining,getGlideMode());
        }
    }
}

