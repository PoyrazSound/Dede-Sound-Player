<script id="vm-per-zone-inspector-fix-js">
(()=>{
  const $=id=>document.getElementById(id);
  const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));
  const noteName=n=>{const names=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];n=Number(n)||0;return names[((n%12)+12)%12]+(Math.floor(n/12)-1)};
  let selected=-1;
  function program(){try{return window.__DEDE_PROGRAM_API?.getCurrentProgram()||null}catch(e){return null}}
  function syncSelectedFromZones(){
    const zones=$('vmZones'); if(!zones)return;
    const arr=[...zones.children];
    arr.forEach((el,i)=>el.dataset.vmIndex=i);
    const selectedEl=arr.findIndex(el=>el.classList.contains('sel'));
    if(selectedEl>=0)selected=selectedEl;
  }
  function render(){
    const q=$('vmInspectorContent'), p=program();
    if(!q||!p)return;
    syncSelectedFromZones();
    if(selected<0 || !p.mapping?.[selected]){
      q.innerHTML='<div class="vmTuneNote">Bir sample zone seç. Her zone kendi Volume, Pan, Coarse, Fine, Attack, Release ve velocity ayarlarını bağımsız taşır.</div>';
      return;
    }
    const m=p.mapping[selected];
    m.volume=Number(m.volume??0);m.pan=Number(m.pan??0);m.coarse=Number(m.coarse??0);m.fine=Number(m.fine??(Number(m.tune||0)%100));
