  function begin(e,mode,handle){
    const p=getP(),list=ids();if(!p||!list.length)return;
    const nw=noteW(),sx=e.clientX,sy=e.clientY;
    const base=list.map(i=>{const m=p.mapping[i];return{i,low:Number(m.low),high:Number(m.high),y:Number(m.vmY??55),h:Number(m.vmHeight??56)}});
    drag={mode,handle,sx,sy,nw,base};
