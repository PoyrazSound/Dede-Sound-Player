/* ============================================================
   KEYBOARD
   61 KEYS C2-C7
============================================================ */

const KEYBOARD_START=36;
const KEYBOARD_END=96;

const BLACK_PITCHES=
    new Set([
        1,
        3,
        6,
        8,
        10
    ]);

function createKeyboard(){

    const whiteContainer=
        $("whiteKeys");

    const blackContainer=
        $("blackKeys");

    whiteContainer.innerHTML="";
    blackContainer.innerHTML="";

    Object.keys(
        keyboardElements
    ).forEach(
        k=>delete keyboardElements[k]
    );

    const whites=[];

    for(
        let midi=KEYBOARD_START;
        midi<=KEYBOARD_END;
        midi++
    ){

        if(
            !BLACK_PITCHES.has(
                midi%12
            )
        ){

            whites.push(midi);
        }
    }

    /* WHITE */

    whites.forEach(
        (midi,index)=>{

            const el=
                document.createElement(
                    "div"
                );

            el.className=
                "whiteKey";

            el.innerHTML=
                "<div class='keyLabel'>"+
                midiName(midi)+
                "</div>";

            setupKeyEvents(
                el,
                midi,
                110
            );

            whiteContainer.appendChild(el);

            keyboardElements[midi]=el;
        }
    );

    /* BLACK */

    for(
        let midi=KEYBOARD_START;
        midi<=KEYBOARD_END;
        midi++
    ){

        if(
            !BLACK_PITCHES.has(
                midi%12
            )
        ){
            continue;
        }

        /*
          Siyah tuşun solundaki beyaz
          tuşu buluyoruz.
        */

        const leftMidi=midi-1;

        const leftIndex=
            whites.indexOf(
                leftMidi
            );

        if(leftIndex<0) continue;

        const black=
            document.createElement(
                "div"
            );

        black.className=
            "blackKey";

        /*
          Beyaz tuş genişliği:
          100 / white count.
          Siyah tuş, iki beyazın
          birleşim noktasına konur.
        */

        const percent=
            (
                (leftIndex+1)/
                whites.length
            )*100;

        black.style.left=
            percent+"%";

        setupKeyEvents(
            black,
            midi,
            110
        );

        blackContainer.appendChild(
            black
        );

        keyboardElements[midi]=
            black;
    }
}

