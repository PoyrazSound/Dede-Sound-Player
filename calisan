  function clear(){all=false;selected.clear();paint();status('Seçim temizlendi');}
  function selectOne(i){all=false;selected=new Set([i]);paint();}
  function renderDom(){
    const z=zones(),p=getP();if(!z||!p?.mapping)return;
    const nw=noteW();
    [...z.children].forEach((el,i)=>{const m=p.mapping[i];if(!m)return;
      el.style.left=((Number(m.low)-36)*nw)+'px';
      el.style.width=Math.max(10,(Number(m.high)-Number(m.low)+1)*nw)+'px';
      el.style.top=Number(m.vmY??55)+'px';
      el.style.height=Number(m.vmHeight??56)+'px';
      const info=el.querySelector('.vmZoneInfo');
      if(info&&window.__DEDE_VM_NOTE_NAME)info.textContent=window.__DEDE_VM_NOTE_NAME(m.low)+' → '+window.__DEDE_VM_NOTE_NAME(m.high);
