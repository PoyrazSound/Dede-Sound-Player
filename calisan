function escapeHTML(value){
    return String(value)
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

function midiName(midi){
    const names=[
        "C","C#","D","D#","E","F",
        "F#","G","G#","A","A#","B"
    ];

    return names[midi%12]+
        (Math.floor(midi/12)-1);
}

function getPitchBendRange(){
    const el=document.getElementById("pitchBendRange");
    return el ? Number(el.value)||2 : 2;
}


let masterTuneSemitones=0;
function getMasterTuneCents(){ return masterTuneSemitones*100; }
function applyMasterTune(){
  const cents=getMasterTuneCents();
  for(const v of getAllVoices()){
    if(!v || v.released) continue;
    try{ if(v.source?.detune) setVoiceDetune(v,v.currentNote??v.note); }catch(e){}
  }
}
function getPitchBendCents(){
    // Pitch Bend is an independent additive offset. Center is exactly 0 cents.
    return pitchBend * getPitchBendRange() * 100;
}

function getPitchBendRatio(){
    // Compatibility helper only. Voice pitch calculations MUST NOT use this.
    return Math.pow(2,getPitchBendCents()/1200);
}

function getGlideMs(){
    const el=document.getElementById("glide");
    const ms=Math.round(Number(el?.value ?? 0));
    return Math.min(2000,Math.max(0,Number.isFinite(ms)?ms:0));
}

function getGlideSeconds(){
    return getGlideMs()/1000;
}

function performanceEnabled(){
    const leg=document.getElementById("legato");
    const porta=document.getElementById("portamento");
    const mono=document.getElementById("mono");
    return {
        legato:!!leg?.classList.contains("on"),
        portamento:!!porta?.classList.contains("on"),
        mono:!!mono?.classList.contains("on")
    };
}



function getVoiceTargetRate(voice,targetNote){
    const base=Math.max(.0001,Number(voice.baseNominalRate||voice.nominalRate||1));
    const sampleAnchor=Number(voice.sampleNote ?? voice.note ?? targetNote);
    const delta=Number(targetNote)-sampleAnchor;
    return Math.max(.01,base*Math.pow(2,delta/12));
}

function getNaturalGlideSeconds(voice,targetNote,portamentoOn){
    if(!portamentoOn) return 0;
    const baseMs=getGlideMs();
    if(baseMs<=0) return 0;
    const from=Number(voice.currentNote ?? voice.note ?? targetNote);
    const interval=Math.abs(Number(targetNote)-from);
    // Natural adaptive behavior: very small intervals are quicker, larger
    // intervals retain more of the user's selected glide time.
    const factor=Math.min(1.18, Math.max(0.62, 0.62 + Math.min(24,interval)/24*0.56));
    return Math.max(0.008,(baseMs*factor)/1000);
}

function getGlideMode(){
    return document.getElementById("legatoResponse")?.value||"natural";
}

function scheduleNaturalGlide(param,current,target,duration,mode){
    param.cancelScheduledValues(audioContext.currentTime);
    const now=audioContext.currentTime;
    const start=Math.max(.01,Number(current)||.01);
    const end=Math.max(.01,Number(target)||.01);
    param.setValueAtTime(start,now);
    if(duration<=0){ param.setValueAtTime(end,now); return; }
    // Exponential timing gives a smoother musical glide than a hard linear ramp.
    if(mode==='target'){
        param.setTargetAtTime(end,now,Math.max(.006,duration/3.2));
    }else{
        const d=Math.max(.008,duration);
        // Playback-rate portamento is intentionally a single smooth ramp.
        // The previous multi-stage exponential curve could make short glides
        // feel like they never reached the target or jump at the end.
        param.linearRampToValueAtTime(end,now+d);
    }
}

function retuneVoice(voice,targetNote,forceGlide=true){
    if(!voice || voice.released || !audioContext || !voice.source) return false;
    const now=audioContext.currentTime;
    const portamentoOn=forceGlide===true;
    const glide=getNaturalGlideSeconds(voice,targetNote,portamentoOn);
    const targetRate=getVoiceTargetRate(voice,targetNote);
    voice.currentNote=targetNote;
    voice.nominalRate=Math.max(.01,targetRate);
    try{
        const param=voice.source.playbackRate;
        const current=Math.max(.01,Number(param.value)||.01);
        scheduleNaturalGlide(param,current,targetRate,glide,getGlideMode());
        if(voice.source.detune){
            voice.source.detune.setValueAtTime(getMicroTuneCents(targetNote)+getPitchBendCents()+getMasterTuneCents(),now);
        }
        voice.glideActive=glide>0;
        voice.glideMs=Math.round(glide*1000);
        if(voice.octaveSource){
            const oct=Math.pow(2,Number(voice.octaveShift||0));
            const op=voice.octaveSource.playbackRate;
            const ocurrent=Math.max(.01,Number(op.value)||.01);
            const otarget=Math.max(.01,targetRate*oct);
            scheduleNaturalGlide(op,ocurrent,otarget,glide,getGlideMode());
            if(voice.octaveSource.detune){
                voice.octaveSource.detune.setValueAtTime(getMicroTuneCents(targetNote)+getPitchBendCents()+getMasterTuneCents(),now);
            }
        }
        return true;
    }catch(e){ console.warn('retuneVoice',e); return false; }
}

function applyPitchBendToVoices(){
    if(!audioContext) return;
    const now=audioContext.currentTime;
    const cents=getPitchBendCents();
    for(const voice of getAllVoices()){
        if(!voice || voice.released) continue;
        try{
            // Legato/Portamento own playbackRate. Pitch Bend owns detune.
            if(voice.source && voice.source.detune){
                voice.source.detune.cancelScheduledValues(now);
                voice.source.detune.setValueAtTime(getMicroTuneCents(voice.currentNote??voice.note)+cents+getMasterTuneCents(),now);
            }
            if(voice.octaveSource && voice.octaveSource.detune){
                voice.octaveSource.detune.cancelScheduledValues(now);
                voice.octaveSource.detune.setValueAtTime(getMicroTuneCents(voice.currentNote??voice.note)+cents+getMasterTuneCents(),now);
            }
            voice.pitchBendCents=cents;
        }catch(e){}
    }
}

