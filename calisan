/* ============================================================
   PERFORMANCE SWITCH CONTROLLER — V4
   POLY / MONO / LEGATO / PORTAMENTO are real controls, not visual-only.
============================================================ */
(function installPerformanceSwitches(){
  const ids=["poly","mono","legato","portamento"];
  const buttons=ids.map(id=>document.getElementById(id)).filter(Boolean);
  if(!buttons.length) return;

  function setOn(id,on){
    const b=document.getElementById(id);
    if(!b) return;
    b.classList.toggle("on",!!on);
    b.setAttribute("aria-pressed",on?"true":"false");
  }

  buttons.forEach(b=>{
    b.type="button";
    b.addEventListener("click",()=>{
      const id=b.id;
      const currently=b.classList.contains("on");

      if(id==="poly"){
        setOn("poly",true); setOn("mono",false);
        // Changing voice architecture while notes are sounding can leave an
        // old poly voice alive. Flush it once, then use the new mode.
        if(!currently) stopAllVoices();
      }else if(id==="mono"){
        setOn("mono",true); setOn("poly",false);
        if(!currently) stopAllVoices();
      }else if(id==="legato"){
        setOn("legato",!currently);
        // Legato changes the articulation mode; don't kill a currently held
        // note, but the next note uses the new setting.
      }else if(id==="portamento"){
        const next=!currently;
        setOn("portamento",next);
        // Apply the new state to the currently held mono voice immediately.
        // This also cancels any stale scheduled ramp when turning PORTAMENTO off.
        const p=performanceEnabled();
        if(p.legato || p.mono){
          const v=monoVoice;
          if(v && !v.released && v.currentNote!=null){
            retuneVoice(v,v.currentNote,next);
          }
        }
      }
      if(typeof window.updatePerformanceStatus==="function") window.updatePerformanceStatus();
    });
  });

  // Enforce a safe initial state: POLY and MONO are mutually exclusive.
  if(document.getElementById("mono")?.classList.contains("on")){
    setOn("poly",false);
  }else{
    setOn("poly",true);
    setOn("mono",false);
  }
})();

