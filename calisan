const __dedeOriginalSetFxPreset=setFxPreset;
function applyFactoryPreset(name){
  const profile=dedePresetProfiles[name];
  if(!profile) return;
  // First clear all FX, then apply only this preset's states.
  __dedeOriginalSetFxPreset('alloff');
  const states=profile.states||{};
  Object.keys(fxState).forEach(k=>{fxState[k]=!!states[k];});
  const params=profile.params||{};
  Object.entries(params).forEach(([id,value])=>{const el=document.getElementById(id);if(el)el.value=String(value);});
  document.querySelectorAll('.fxToggle').forEach(btn=>{const fx=btn.dataset.fx;btn.classList.toggle('on',!!fxState[fx]);btn.textContent=fxState[fx]?'ON':'OFF';});
  if(typeof updateFx==='function') updateFx();
  const select=document.getElementById('fxPresetSelect');
  if(select && name in dedePresetProfiles && [...select.options].some(o=>o.value===name)) select.value=name;
}
setFxPreset=function(name){
  // Existing dropdown presets remain compatible; new factory profiles get parameters too.
  if(dedePresetProfiles[name]) { applyFactoryPreset(name); return; }
  __dedeOriginalSetFxPreset(name);
};

$("fxPresetSelect")
.addEventListener("change",function(){
    setFxPreset(this.value);
});

/* ============================================================
   SF2 PARSER
============================================================ */

function readString(data,offset,length){

    let result="";

    for(let i=0;i<length;i++){

        if(offset+i>=data.byteLength) break;

        const c=data.getUint8(offset+i);

        if(c===0) break;

        result+=String.fromCharCode(c);
    }

    return result.trim();
}

function readU16(data,offset){
    return data.getUint16(offset,true);
}

function readI16(data,offset){
    return data.getInt16(offset,true);
}

function readU32(data,offset){
    return data.getUint32(offset,true);
}

function readI8(data,offset){
    return data.getInt8(offset);
}

function getChunks(data,start,end){

    const result=[];
    let position=start;

    while(position+8<=end){

        const id=
            readString(data,position,4);

        const size=
            readU32(data,position+4);

        const content=
            position+8;

        if(content+size>end) break;

        result.push({
            id,
            start:content,
            size
        });

        position=
            content+
            size+
            (size&1);
    }

    return result;
}

function parseSF2(buffer){

    const data=new DataView(buffer);

    if(
        readString(data,0,4)!=="RIFF"||
        readString(data,8,4)!=="sfbk"
    ){
        throw new Error(
            "Geçerli bir SF2 dosyası değil."
        );
    }

    let sdta=null;
    let pdta=null;

    const rootChunks=
        getChunks(
            data,
            12,
            data.byteLength
        );

    for(const chunk of rootChunks){

        if(chunk.id==="LIST"){

            const type=
                readString(
                    data,
                    chunk.start,
                    4
                );

            if(type==="sdta")
                sdta=chunk;

            if(type==="pdta")
                pdta=chunk;
        }
    }

    if(!sdta||!pdta){
        throw new Error(
            "SF2 pdta/sdta bulunamadı."
        );
    }

    const sdtaChunks=
        getChunks(
            data,
            sdta.start+4,
            sdta.start+sdta.size
        );

    const smplChunk=
        sdtaChunks.find(
            x=>x.id==="smpl"
        );

    if(!smplChunk){
        throw new Error(
            "SF2 PCM sample verisi bulunamadı."
        );
    }

    const pdtaChunks=
        getChunks(
            data,
            pdta.start+4,
            pdta.start+pdta.size
        );

    const recordSizes={
        phdr:38,
        pbag:4,
        pgen:4,
        inst:22,
        ibag:4,
        igen:4,
        shdr:46
    };

    const records={};

    for(const chunk of pdtaChunks){

        const size=
            recordSizes[chunk.id];

        if(!size) continue;

        records[chunk.id]=[];

        for(
            let p=chunk.start;
            p+size<=chunk.start+chunk.size;
            p+=size
        ){
            records[chunk.id].push(p);
        }
    }

    const phdr=records.phdr||[];
    const pbag=records.pbag||[];
    const pgen=records.pgen||[];
    const inst=records.inst||[];
    const ibag=records.ibag||[];
    const igen=records.igen||[];
    const shdr=records.shdr||[];

    const samples=[];

    for(let i=0;i<shdr.length-1;i++){

        const p=shdr[i];

        samples.push({

            name:
                readString(
                    data,
                    p,
                    20
                ),

            start:
                readU32(data,p+20),

            end:
                readU32(data,p+24),

            loopStart:
                readU32(data,p+28),

            loopEnd:
                readU32(data,p+32),

            rate:
                readU32(data,p+36),

            root:
                data.getUint8(p+40),

            pitch:
                readI8(data,p+41),

            link:
                readU16(data,p+42),

            type:
                readU16(data,p+44)
        });
    }

    function generators(array){

        return array.map(p=>({

            op:
                readU16(data,p),

            amt:
                readI16(data,p+2),

            raw:
                readU16(data,p+2)
        }));
    }

    const presetGenerators=
        generators(pgen);

    const instrumentGenerators=
        generators(igen);

    function bagRanges(
        bags,
        generatorsArray
    ){

        const result=[];

        for(let i=0;i<bags.length-1;i++){

            result.push(
                generatorsArray.slice(
                    readU16(
                        data,
                        bags[i]
                    ),
                    readU16(
                        data,
                        bags[i+1]
                    )
                )
            );
        }

        return result;
    }

    const presetZones=
        bagRanges(
            pbag,
            presetGenerators
        );

    const instrumentZones=
        bagRanges(
            ibag,
            instrumentGenerators
        );

    const instruments=[];

    for(let i=0;i<inst.length-1;i++){

        const start=
            readU16(
                data,
                inst[i]+20
            );

        const end=
            readU16(
                data,
                inst[i+1]+20
            );

        const zones=[];

        for(let j=start;j<end;j++){

            zones.push(
                instrumentZones[j]||[]
            );
        }

        instruments.push({

            name:
                readString(
                    data,
                    inst[i],
                    20
                ),

            zones
        });
    }

    const presets=[];

    for(let i=0;i<phdr.length-1;i++){

        const p=phdr[i];
        const next=phdr[i+1];

        const start=
            readU16(data,p+24);

        const end=
            readU16(data,next+24);

        const zones=[];

        for(let j=start;j<end;j++){

            zones.push(
                presetZones[j]||[]
            );
        }

        presets.push({

            name:
                readString(
                    data,
                    p,
                    20
                ),

            program:
                readU16(data,p+20),

            bank:
                readU16(data,p+22),

            zones
        });
    }

    function findZones(
        preset,
        note,
        velocity
    ){

        const result=[];

        for(const presetZone of preset.zones){

            const instrumentGen=
                presetZone.find(
                    g=>g.op===41
                );

            if(!instrumentGen) continue;

            const instData=
                instruments[
                    instrumentGen.amt
                ];

            if(!instData) continue;

            for(
                const instrumentZone
                of instData.zones
            ){

                const sampleGen=
                    instrumentZone.find(
                        g=>g.op===53
                    );

                if(
                    sampleGen&&
                    samples[sampleGen.amt]
                ){

                    result.push({

                        presetZone,
                        instrumentZone,
                        sample:
                            samples[
                                sampleGen.amt
                            ]
                    });
                }
            }
        }

        return result.length
            ? result
            : [
                {
                    presetZone:[],
                    instrumentZone:[],
                    sample:samples[0]
                }
            ];
    }

    return {

        data,
        samples,
        presets,
        findZones,

        pcmStart:
            smplChunk.start,

        pcmBytes:
            smplChunk.size
    };
}

/* ============================================================
   PCM
============================================================ */

function preparePCM(){

    if(
        !soundFont||
        soundFont.audio
    ) return;

    const count=
        Math.floor(
            soundFont.pcmBytes/2
        );

    soundFont.audio=
        new Float32Array(count);

    for(let i=0;i<count;i++){

        soundFont.audio[i]=
            readI16(
                soundFont.data,
                soundFont.pcmStart+i*2
            )/32768;
    }
}

/* ============================================================
   VOICES
============================================================ */

function getAllVoices(){

    const result=[];

    for(
        const list
        of activeVoices.values()
    ){
        for(
            const voice
            of list
        ){
            result.push(voice);
        }
    }

    return result;
}

function updateVoiceCount(){

    $("voiceCount").textContent=
        getAllVoices().length+
        "/"+
        MAX_VOICES;
}

function addVoice(voice){

    if(
        !activeVoices.has(
            voice.note
        )
    ){
        activeVoices.set(
            voice.note,
            []
        );
    }

    activeVoices
        .get(voice.note)
        .push(voice);

    updateVoiceCount();
}

function removeVoice(voice){

    for(
        const [key,list]
        of activeVoices
    ){

        const index=
            list.indexOf(voice);

        if(index!==-1){

            list.splice(
                index,
                1
            );

            if(list.length===0){
                activeVoices.delete(key);
            }

            break;
        }
    }

    if(monoVoice===voice){
        monoVoice=null;
    }

    updateVoiceCount();
}

/* ============================================================
   CREATE SF2 VOICE
============================================================ */

async function createSF2Voice(
    note,
    velocity,
    zone
){

    await initializeAudio();

    preparePCM();

    const sample=zone.sample;

    let start=
        Math.max(
            0,
            Math.floor(sample.start)
        );

    let end=
        Math.min(
            soundFont.audio.length,
            Math.floor(sample.end)
        );

    if(end<=start){
        return null;
    }

    const baseRate=
        Math.pow(
            2,
            (note-sample.root)/12
        );

    const buffer=
        audioContext.createBuffer(
            1,
            end-start,
            sample.rate||44100
        );

    buffer.copyToChannel(
        soundFont.audio.subarray(
            start,
            end
        ),
        0
    );

    const source=
        audioContext.createBufferSource();

    source.buffer=buffer;

    let rate=
        baseRate;

    /* Pitch FX */

    if(fxState.pitch){

        const shift=
            Number(
                $("fx_pitch_shift").value
            );

        const mix=
            Number(
                $("fx_pitch_mix").value
            );

        const shifted=
            Math.pow(
                2,
                shift/12
            );

        rate=
            baseRate*
            (
                1-mix+
                shifted*mix
            );
    }

    source.playbackRate.value=
        Math.max(.01,rate);
    if(source.detune){
        source.detune.value=getMicroTuneCents(note)+getPitchBendCents()+getMasterTuneCents();
    }

    const gain=
        audioContext.createGain();

    const vmin=Number(item.velMin??1), vmax=Number(item.velMax??127);
    if(item.mute || velocity<vmin || velocity>vmax) return null;
    const soloActive=activeProgramMapping instanceof Map && [...activeProgramMapping.values()].some(v=>v?.solo);
    if(soloActive && !item.solo) return null;
    const velocityGain=Math.max(.0001,Math.min(1,velocity/127));
    const dbGain=Number(item.volume??0);
    const amplitude=Math.max(.0001,Math.min(1,velocityGain*Math.pow(10,dbGain/20)));

    const attack=
        Math.max(
            .001,
            Number($("attack").value)
        );

    const decay=
        Math.max(
            .001,
            Number($("decay").value)
        );

    const sustain=
        Math.max(
            0,
            Math.min(
                1,
                Number($("sustain").value)
            )
        );

    const now=
        audioContext.currentTime;

    gain.gain.setValueAtTime(
        0,
        now
    );

    gain.gain.linearRampToValueAtTime(
        amplitude,
        now+attack
    );

    gain.gain.linearRampToValueAtTime(
        amplitude*sustain,
        now+attack+decay
    );

    source.connect(gain);
    if(audioContext.createStereoPanner){
        const panNode=audioContext.createStereoPanner();
        panNode.pan.value=Math.max(-1,Math.min(1,Number(item.pan??0)/100));
        gain.connect(panNode);
        panNode.connect(fxChain.performanceGain);
    }else{
        gain.connect(fxChain.performanceGain);
    }

    const voice={
        id:++voiceCounter,
        type:"sf2",
        source,
        gain,
        note,
        velocity,
        baseRate,
        nominalRate:rate,
        currentNote:note,
        released:false,
        octaveSource:null,
        octaveGain:null,
        octaveShift:0,
        envelope:{attack:geAttack,decay:geDecay,sustain:geSustain,release:Number($("release")?.value||.5)}
    };

    /* ========================================================
       REAL OCTAVER
    ======================================================== */

    if(fxState.oct){

        const octave=
            Number(
                $("fx_oct_shift").value
            );

        const mix=
            Number(
                $("fx_oct_mix").value
            );

        if(mix>0){

            const octSource=
                audioContext.createBufferSource();

            octSource.buffer=buffer;

            octSource.playbackRate.value=
                rate*
                Math.pow(2,octave);
            if(octSource.detune){
                octSource.detune.value=getMicroTuneCents(note)+getPitchBendCents()+getMasterTuneCents();
            }

            const octGain=
                audioContext.createGain();

            octGain.gain.value=
                amplitude*mix;

            octSource.connect(
                octGain
            );

            octGain.connect(
                fxChain.input
            );

            octSource.start(now);

            voice.octaveSource=
                octSource;

            voice.octaveGain=
                octGain;
            voice.octaveShift=octave;
        }
    }

    source.onended=()=>{
        removeVoice(voice);
        if(monoVoice===voice) monoVoice=null;
    };

    source.start(now);

    return voice;
}

