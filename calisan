============================================================ */

function updateCabinet(){

    if(!audioContext) return;

    if(!fxState.cab){

        fxChain.cabHP.frequency.value=20;
        fxChain.cabLP.frequency.value=
            Math.min(
                audioContext.sampleRate/2-100,
                20000
            );

        fxChain.cabMid.gain.value=0;

        return;
    }

    const type=$("fx_cab_type").value;
    const mic=$("fx_cab_mic").value;

    let hp=80;
    let lp=6500;
    let mid=0;
    let midFreq=2200;

    if(type==="1x12"){
        hp=85;
        lp=6200;
        mid=2;
        midFreq=1800;
    }

    if(type==="2x12"){
        hp=75;
        lp=6800;
        mid=1;
        midFreq=2100;
    }

    if(type==="4x12"){
        hp=70;
        lp=5700;
        mid=3;
        midFreq=2300;
    }

    if(type==="vintage"){
        hp=80;
        lp=4800;
        mid=4;
        midFreq=1900;
    }

    if(type==="8x10"){
        hp=45;
        lp=4200;
        mid=2;
        midFreq=900;
    }

    if(mic==="center"){
        lp+=700;
        mid+=1;
    }

    if(mic==="edge"){
        lp-=600;
        mid-=1;
    }

    if(mic==="room"){
        lp-=1000;
        mid-=2;
    }

    fxChain.cabHP.frequency.value=hp;
    fxChain.cabLP.frequency.value=lp;
    fxChain.cabMid.frequency.value=midFreq;
    fxChain.cabMid.gain.value=mid;
}

/* ============================================================
   REVERB IMPULSE
============================================================ */

function createReverbImpulse(seconds=2.5,damping=.45,diffusion=.78,shimmer=false,size=.65){
    const rate=audioContext.sampleRate, length=Math.max(1,Math.floor(rate*seconds));
    const impulse=audioContext.createBuffer(2,length,rate);
    for(let c=0;c<2;c++){
        const data=impulse.getChannelData(c);
        for(let i=0;i<length;i++){
            const t=i/length;
            const env=Math.pow(1-t,1.15+damping*2.8);
            const early=i<rate*.09?(1-(i/(rate*.09))*.25):1;
            const diffusionMod=(1-diffusion)*.25*Math.sin(i*.017+c*1.9);
            const shimmerGain=shimmer?(1+.16*Math.sin(i*.00065+c)) : 1;
            data[i]=(Math.random()*2-1)*env*early*(.65+.35*size)*(1+diffusionMod)*shimmerGain;
        }
    }
    return impulse;
}

/* ============================================================
   INITIALIZE AUDIO
============================================================ */

async function initializeAudio(){

    const AudioContextClass=
        window.AudioContext||
        window.webkitAudioContext;

    if(!AudioContextClass){
        throw new Error(
            "Web Audio API desteklenmiyor."
        );
    }

    if(!audioContext){

        audioContext=
            new AudioContextClass();

        /* MASTER */

        fxChain.master=
            audioContext.createGain();

        fxChain.master.gain.value=
            Number($("master").value);

        /* INPUT */

        fxChain.input=
            audioContext.createGain();

        /* DYNAMICS */

        fxChain.gate=
            audioContext.createDynamicsCompressor();

        fxChain.comp=
            audioContext.createDynamicsCompressor();

        fxChain.limiter=
            audioContext.createDynamicsCompressor();

        /* DRIVE */

        fxChain.dist=
            audioContext.createWaveShaper();

        fxChain.ampDrive=
            audioContext.createWaveShaper();

        /* AMP / TONE */

        fxChain.ampLow=
            audioContext.createBiquadFilter();

        fxChain.ampHigh=
            audioContext.createBiquadFilter();

        /* CABINET */

        fxChain.cabHP=
            audioContext.createBiquadFilter();

        fxChain.cabLP=
            audioContext.createBiquadFilter();

        fxChain.cabMid=
            audioContext.createBiquadFilter();

        /* EQ */

        fxChain.eqMid=
            audioContext.createBiquadFilter();

        fxChain.eqPresence=
            audioContext.createBiquadFilter();

        /* FILTER */

        fxChain.filter=
            audioContext.createBiquadFilter();

        /* DELAY */

        fxChain.delay=
            audioContext.createDelay(2);

        fxChain.delayFeedback=
            audioContext.createGain();

        fxChain.delayWet=
            audioContext.createGain();

        fxChain.delayDry=
            audioContext.createGain();

        fxChain.delayFilter=audioContext.createBiquadFilter();
        fxChain.delayHP=audioContext.createBiquadFilter();
        fxChain.delayPan=audioContext.createStereoPanner();
        fxChain.delayLFO=audioContext.createOscillator();
        fxChain.delayModDepth=audioContext.createGain();

        /* REVERB */

        fxChain.reverb=
            audioContext.createConvolver();

        fxChain.reverbWet=
            audioContext.createGain();

        fxChain.reverbDry=
            audioContext.createGain();

        fxChain.reverbFilter=audioContext.createBiquadFilter();
        fxChain.reverbHP=audioContext.createBiquadFilter();
        fxChain.reverbPan=audioContext.createStereoPanner();
        fxChain.reverbPre=audioContext.createDelay(.25);

        /* MODULATION */

        fxChain.modDelay=
            audioContext.createDelay(1);

        fxChain.modWet=
            audioContext.createGain();

        fxChain.modDry=
            audioContext.createGain();

        fxChain.modLFO=
            audioContext.createOscillator();

        fxChain.modDepth=
            audioContext.createGain();

        /* AUTO WAH */

        fxChain.wah=
            audioContext.createBiquadFilter();

        fxChain.wahWet=
            audioContext.createGain();

        fxChain.wahDry=
            audioContext.createGain();

        /* STEREO */

        fxChain.stereo=
            audioContext.createStereoPanner();

        /* INIT VALUES */

        fxChain.gate.threshold.value=-100;
        fxChain.gate.knee.value=0;
        fxChain.gate.ratio.value=20;
        fxChain.gate.attack.value=.001;
        fxChain.gate.release.value=.1;

        fxChain.comp.threshold.value=-24;
        fxChain.comp.ratio.value=1;
        fxChain.comp.attack.value=.003;
        fxChain.comp.release.value=.2;

        fxChain.limiter.threshold.value=0;
        fxChain.limiter.ratio.value=1;

        fxChain.dist.curve=null;

        fxChain.ampDrive.curve=null;

        fxChain.ampLow.type="lowshelf";
        fxChain.ampLow.frequency.value=150;

        fxChain.ampHigh.type="highshelf";
        fxChain.ampHigh.frequency.value=3500;

        fxChain.cabHP.type="highpass";
        fxChain.cabLP.type="lowpass";
        fxChain.cabMid.type="peaking";

        fxChain.eqMid.type="peaking";
        fxChain.eqMid.frequency.value=1000;
        fxChain.eqMid.Q.value=.8;

        fxChain.eqPresence.type="peaking";
        fxChain.eqPresence.frequency.value=3500;
        fxChain.eqPresence.Q.value=.7;

        fxChain.filter.type="lowpass";
        fxChain.filter.frequency.value=20000;

        fxChain.delayWet.gain.value=0;
        fxChain.delayDry.gain.value=1;
        fxChain.delayFilter.type="lowpass";
        fxChain.delayFilter.frequency.value=11000;
        fxChain.delayHP.type="highpass";
        fxChain.delayHP.frequency.value=100;
        fxChain.delayLFO.frequency.value=.35;
        fxChain.delayModDepth.gain.value=0;

        fxChain.reverbWet.gain.value=0;
        fxChain.reverbDry.gain.value=1;
        fxChain.reverbFilter.type="lowpass";
        fxChain.reverbFilter.frequency.value=10000;
        fxChain.reverbHP.type="highpass";
        fxChain.reverbHP.frequency.value=120;
        fxChain.reverbPre.delayTime.value=.028;

        fxChain.modWet.gain.value=0;
        fxChain.modDry.gain.value=1;

        fxChain.wahWet.gain.value=0;
        fxChain.wahDry.gain.value=1;

        fxChain.modDelay.delayTime.value=.025;
        fxChain.modDepth.gain.value=.001;

        fxChain.wah.type="bandpass";
        fxChain.wah.frequency.value=900;
        fxChain.wah.Q.value=5;

        fxChain.reverb.buffer=
            createReverbImpulse(2.5);

        /* ====================================================
           PERFORMANCE INPUT VOLUME
           Modulation acts before the insert FX chain.
           FX tails are therefore independent of this control.
        ==================================================== */
        fxChain.performanceGain = audioContext.createGain();
        fxChain.performanceGain.gain.value = (typeof modulationVolume === "number" ? modulationVolume : 1);
        fxChain.performanceHP = audioContext.createBiquadFilter();
         fxChain.performanceHP.type="highpass";
         fxChain.performanceHP.frequency.value=20;
         fxChain.performanceHP.Q.value=.0001;
         fxChain.performanceGain.connect(fxChain.performanceHP);
         fxChain.performanceHP.connect(fxChain.input);

        /* ====================================================
           MAIN SERIAL CHAIN
        ==================================================== */

        fxChain.input.connect(fxChain.gate);
        fxChain.gate.connect(fxChain.comp);

        fxChain.comp.connect(fxChain.dist);
        fxChain.dist.connect(fxChain.ampDrive);

        fxChain.ampDrive.connect(fxChain.ampLow);
        fxChain.ampLow.connect(fxChain.ampHigh);

        fxChain.ampHigh.connect(fxChain.cabHP);
        fxChain.cabHP.connect(fxChain.cabLP);
        fxChain.cabLP.connect(fxChain.cabMid);

        fxChain.cabMid.connect(fxChain.eqMid);
        fxChain.eqMid.connect(fxChain.eqPresence);

        fxChain.eqPresence.connect(fxChain.filter);

        /* ====================================================
           DELAY
        ==================================================== */

        fxChain.filter.connect(fxChain.delayDry);
        fxChain.filter.connect(fxChain.delay);

        fxChain.delay.connect(fxChain.delayFeedback);
        fxChain.delayFeedback.connect(fxChain.delay);

        fxChain.delay.connect(fxChain.delayHP);
        fxChain.delayHP.connect(fxChain.delayFilter);
        fxChain.delayFilter.connect(fxChain.delayPan);
        fxChain.delayPan.connect(fxChain.delayWet);

        /* ====================================================
           REVERB
        ==================================================== */

        fxChain.filter.connect(fxChain.reverbDry);
        fxChain.filter.connect(fxChain.reverb);

        fxChain.reverb.connect(fxChain.reverbHP);
        fxChain.reverbHP.connect(fxChain.reverbPre);
        fxChain.reverbPre.connect(fxChain.reverbFilter);
        fxChain.reverbFilter.connect(fxChain.reverbPan);
        fxChain.reverbPan.connect(fxChain.reverbWet);

        /* ====================================================
           MODULATION
        ==================================================== */

        fxChain.filter.connect(fxChain.modDry);
        fxChain.filter.connect(fxChain.modDelay);

        fxChain.modDelay.connect(fxChain.modWet);

        fxChain.modLFO.connect(fxChain.modDepth);
        fxChain.modDepth.connect(
            fxChain.modDelay.delayTime
        );

        fxChain.modLFO.start();
        fxChain.delayLFO.connect(fxChain.delayModDepth);
        fxChain.delayModDepth.connect(fxChain.delay.delayTime);
        fxChain.delayLFO.start();

        /* ====================================================
           WAH
        ==================================================== */

        fxChain.filter.connect(fxChain.wahDry);
        fxChain.filter.connect(fxChain.wah);

        fxChain.wah.connect(fxChain.wahWet);

        /* ====================================================
           MIX BUS
        ==================================================== */

        fxChain.delayDry.connect(fxChain.limiter);
        fxChain.delayWet.connect(fxChain.limiter);

        fxChain.reverbDry.connect(fxChain.limiter);
        fxChain.reverbWet.connect(fxChain.limiter);

        fxChain.modDry.connect(fxChain.limiter);
        fxChain.modWet.connect(fxChain.limiter);

        fxChain.wahDry.connect(fxChain.limiter);
        fxChain.wahWet.connect(fxChain.limiter);

        fxChain.limiter.connect(fxChain.stereo);

        /* MASTER PAN — gerçek stereo çıkış kontrolü */
        fxChain.masterPan = audioContext.createStereoPanner();
        fxChain.masterPan.pan.value = 0;

        fxChain.stereo.connect(fxChain.masterPan);
        fxChain.masterPan.connect(fxChain.master);
        fxChain.master.connect(
            audioContext.destination
        );

        updateFx();
    }

    if(audioContext.state!=="running"){
        await audioContext.resume();
    }

    $("engineStatus").textContent=
        soundFont
        ? "SF2 + GUITAR FX READY"
        : "AUDIO ENGINE READY";

    $("statusLed").classList.add("ready");
}

/* ============================================================
   FX UPDATE
============================================================ */

function updateFx(){

    if(!audioContext) return;

    /* GATE */

    if(fxState.gate){

        fxChain.gate.threshold.value=
            Number($("fx_gate_thresh").value);

        fxChain.gate.ratio.value=20;

    }else{

        fxChain.gate.threshold.value=-100;
        fxChain.gate.ratio.value=1;
    }

    /* COMP */

    if(fxState.comp){

        fxChain.comp.threshold.value=
            Number($("fx_comp_thresh").value);

        fxChain.comp.ratio.value=
            Number($("fx_comp_ratio").value);

    }else{

        fxChain.comp.threshold.value=0;
        fxChain.comp.ratio.value=1;
    }

    /* LIMITER */

    if(fxState.lim){

        fxChain.limiter.threshold.value=
            Number($("fx_lim_ceil").value);

        fxChain.limiter.ratio.value=20;

        fxChain.limiter.release.value=
            Number($("fx_lim_rel").value);

    }else{

        fxChain.limiter.threshold.value=0;
        fxChain.limiter.ratio.value=1;
    }

    /* DISTORTION */

    if(fxState.dist){

        const amount=
            Number($("fx_dist_amount").value);

        fxChain.dist.curve=
            makeDistortionCurve(
                amount,
                $("fx_dist_type").value
            );

        fxChain.dist.oversample="4x";

    }else{

        fxChain.dist.curve=null;
    }

    /* AMP */

    if(fxState.amp){

        const model=
            $("fx_amp_model").value;

        const gain=
            Number($("fx_amp_gain").value);

        let freq=5000;

        if(model==="british") freq=4300;
        if(model==="american") freq=5200;
        if(model==="highgain") freq=3800;
        if(model==="metal") freq=3200;

        fxChain.ampHigh.frequency.value=freq;

        if(gain>0){

            fxChain.ampDrive.curve=
                makeDistortionCurve(
                    gain*35,
                    model==="metal"
                    ? "metal"
                    : "crunch"
                );

            fxChain.ampDrive.oversample="4x";

        }else{

            fxChain.ampDrive.curve=null;
        }

    }else{

        fxChain.ampDrive.curve=null;
    }

    /* AMP TONE */

    if(fxState.amptone){

        fxChain.ampLow.gain.value=
            Number($("fx_amp_bass").value);

        fxChain.ampHigh.gain.value=
            Number($("fx_amp_treble").value);

    }else{

        fxChain.ampLow.gain.value=0;
        fxChain.ampHigh.gain.value=0;
    }

    /* CAB */

    updateCabinet();

    /* EQ */

    if(fxState.eq){

        fxChain.eqMid.gain.value=
            Number($("fx_eq_mid").value);

        fxChain.eqPresence.gain.value=
            Number($("fx_eq_pres").value);

    }else{

        fxChain.eqMid.gain.value=0;
        fxChain.eqPresence.gain.value=0;
    }

    /* FILTER */

    if(fxState.filt){

        fxChain.filter.frequency.value=
            Number($("fx_filt_cut").value);

        fxChain.filter.Q.value=
            Number($("fx_filt_res").value);

    }else{

        fxChain.filter.frequency.value=
            20000;

        fxChain.filter.Q.value=.0001;
    }

    /* DELAY — DIGITAL / ANALOG / TAPE / PING PONG / STEREO / SLAPBACK / DOTTED 1/8 */
    if(fxState.del){
        const type=$("fx_del_type").value;
        const bpm=Number($("fx_del_bpm").value)||120;
        const div=$("fx_del_div").value;
        let time=Number($("fx_del_time").value)/1000;
        if($("fx_del_sync").value==="on"){
            const q=60/bpm;
            if(div==="1/8") time=q/2;
            else if(div==="1/8d") time=q*.75;
            else if(div==="1/4") time=q;
            else if(div==="1/2") time=q*2;
            else if(div==="1bar") time=q*4;
        }
        if(type==="dotted8") time=.75*(60/bpm);
        if(type==="slapback") time=Math.min(.18,Math.max(.025,time));
        let fb=Number($("fx_del_fb").value), mix=Number($("fx_del_mix").value), high=Number($("fx_del_high").value), low=Number($("fx_del_low").value), mod=Number($("fx_del_mod").value), width=Number($("fx_del_width").value);
        if(type==="analog"){high=Math.min(high,7000);fb=Math.min(fb,.82);}
        if(type==="tape"){high=Math.min(high,5200);mod=Math.max(mod,.18);}
        if(type==="slapback"){fb=Math.min(fb,.18);mix=Math.min(mix,.35);}
        if(type==="pingpong") width=1;
        const now=audioContext.currentTime;
        fxChain.delay.delayTime.cancelScheduledValues(now);
        fxChain.delay.delayTime.setTargetAtTime(Math.min(2,Math.max(.001,time)),now,.004);
        fxChain.delayFeedback.gain.value=Math.min(.9,fb);
        fxChain.delayWet.gain.value=mix;
        fxChain.delayDry.gain.value=1;
        fxChain.delayHP.frequency.value=low;
        fxChain.delayFilter.frequency.value=high;
        fxChain.delayPan.pan.value=type==="pingpong"?0.0:0.0;
        fxChain.delayModDepth.gain.value=(type==="tape"||type==="analog")?mod*.003:0;
        $("fx_del_time_val").textContent=Math.round(time*1000)+" ms";
        $("fx_del_fb_val").textContent=Math.round(fb*100)+"%";
        $("fx_del_mix_val").textContent=Math.round(mix*100)+"%";
        $("fx_del_width_val").textContent=Math.round(width*100)+"%";
        $("fx_del_low_val").textContent=Math.round(low)+" Hz";
        $("fx_del_high_val").textContent=(high>=1000?(high/1000).toFixed(1)+" kHz":Math.round(high)+" Hz");
        $("fx_del_mod_val").textContent=Math.round(mod*100)+"%";
        $("fx_del_duck_val").textContent=Math.round(Number($("fx_del_duck").value)*100)+"%";
        $("fx_del_bpm_val").textContent=bpm+" BPM";
    }else{
        fxChain.delayFeedback.gain.value=0; fxChain.delayWet.gain.value=0; fxChain.delayDry.gain.value=1; fxChain.delayModDepth.gain.value=0;
    }

    /* REVERB — ROOM / CHAMBER / PLATE / HALL / CATHEDRAL / SHIMMER */
    if(fxState.rev){
        const type=$("fx_rev_type").value, decay=Number($("fx_rev_decay").value), damp=Number($("fx_rev_damp").value), diff=Number($("fx_rev_diff").value), pre=Number($("fx_rev_predelay").value)/1000;
        const size=Number($("fx_rev_size").value);
        let actual=decay;
        if(type==="room") actual=Math.min(decay,1.8);
        if(type==="chamber") actual=Math.min(decay,3.2);
        if(type==="plate") actual=Math.min(decay,5.5);
        if(type==="hall") actual=Math.min(decay,7.5);
        if(type==="cathedral") actual=Math.min(decay,12);
        if(type==="shimmer") actual=Math.min(decay,10);
        fxChain.reverb.buffer=createReverbImpulse(actual,damp,diff,type==="shimmer",size);
        fxChain.reverbPre.delayTime.value=pre;
        fxChain.reverbHP.frequency.value=Number($("fx_rev_low").value);
        fxChain.reverbFilter.frequency.value=Number($("fx_rev_high").value);
        fxChain.reverbWet.gain.value=Math.min(.95, Number($("fx_rev_mix").value)*1.65);
        fxChain.reverbDry.gain.value=1;
        $("fx_rev_predelay_val").textContent=Math.round(pre*1000)+" ms";
        $("fx_rev_decay_val").textContent=actual.toFixed(1)+" s";
        $("fx_rev_size_val").textContent=Math.round(size*100)+"%";
        $("fx_rev_damp_val").textContent=Math.round(damp*100)+"%";
        $("fx_rev_diff_val").textContent=Math.round(diff*100)+"%";
        const lo=Number($("fx_rev_low").value),hi=Number($("fx_rev_high").value);
        $("fx_rev_low_val").textContent=Math.round(lo)+" Hz";
        $("fx_rev_high_val").textContent=(hi>=1000?(hi/1000).toFixed(1)+" kHz":Math.round(hi)+" Hz");
        $("fx_rev_mix_val").textContent=Math.round(Number($("fx_rev_mix").value)*100)+"%";
        $("fx_rev_width_val").textContent=Math.round(Number($("fx_rev_width").value)*100)+"%";
    }else{ fxChain.reverbWet.gain.value=0; fxChain.reverbDry.gain.value=1; }

    /* MODULATION */

    if(fxState.mod){

        const depth=
            Number($("fx_mod_depth").value);

        const type=
            $("fx_mod_type").value;

        let delay=.025;
        let rate=1.2;

        if(type==="flanger"){
            delay=.004;
            rate=.25;
        }

        if(type==="phaser"){
            delay=.002;
            rate=.7;
        }

        if(type==="tremolo"){
            delay=.001;
            rate=5;
        }

        fxChain.modDelay.delayTime.value=delay;

        fxChain.modDepth.gain.value=
            depth*.018;

        fxChain.modLFO.frequency.value=
            rate;

        fxChain.modWet.gain.value=
            depth*.8;

        fxChain.modDry.gain.value=1;

    }else{

        fxChain.modWet.gain.value=0;
        fxChain.modDry.gain.value=1;
        fxChain.modDepth.gain.value=.0001;
    }

    /* WAH */

    if(fxState.wah){

        const sens=
            Number($("fx_wah_sens").value);

        fxChain.wah.Q.value=
            2+sens*12;

        fxChain.wah.frequency.value=
            500+sens*1800;

        fxChain.wahWet.gain.value=
            Number($("fx_wah_mix").value);

        fxChain.wahDry.gain.value=1;

    }else{

        fxChain.wahWet.gain.value=0;
        fxChain.wahDry.gain.value=1;
    }

    /* STEREO */

    if(fxState.wide){

        const width=
            Number($("fx_wide_amount").value);

        fxChain.stereo.pan.value=
            0;

        fxChain.master.gain.value=
            Number($("fx_out_gain").value);

        /*
          Stereo widener için merkezden kontrollü
          pseudo-width uygulanır.
        */

        fxChain.master.gain.value=
            Number($("fx_out_gain").value);

    }else{

        fxChain.stereo.pan.value=0;

        fxChain.master.gain.value=
            Number($("master").value);
    }
}

