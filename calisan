<script id="dede-project-save-import-v1">
(()=>{
  'use strict';
  const $=id=>document.getElementById(id);
  const status=t=>{const e=$('dedeProjectStatus');if(e)e.textContent='PROJECT: '+t;try{const s=$('editorStatus');if(s)s.textContent=t}catch(_){} };
  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
  const b64=ab=>{let bin='',u=new Uint8Array(ab),chunk=0x8000;for(let i=0;i<u.length;i+=chunk)bin+=String.fromCharCode(...u.subarray(i,i+chunk));return btoa(bin)};
  const fromB64=x=>{const bin=atob(x||'');const u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return u.buffer};
  const safeJSON=v=>JSON.parse(JSON.stringify(v,(k,val)=>{if(k==='file'||k==='buffer'||k==='zoneRef')return undefined;return val}));
  const controlState=()=>{
    const out={};
    document.querySelectorAll('[id]').forEach(el=>{
      const id=el.id;if(!id||id==='dedeProjectFile')return;
      if(['INPUT','SELECT','TEXTAREA'].includes(el.tagName)){
        if(el.type==='file')return;
        out[id]={tag:el.tagName,type:el.type,value:el.value,checked:!!el.checked};
      } else if(el.classList?.contains('switch')||el.classList?.contains('fxToggle')||el.classList?.contains('modeChip')){
        out[id]={tag:el.tagName,className:el.className};
      }
    });
    return out;
  };
  const restoreControls=st=>{
    if(!st)return;
    Object.entries(st).forEach(([id,v])=>{const el=$(id);if(!el)return;if('value' in v && 'value' in el && el.type!=='file')el.value=v.value;if('checked' in v && ('checked' in el))el.checked=!!v.checked;if(v.className&&el.classList){if(el.classList.contains('switch')||el.classList.contains('fxToggle')||el.classList.contains('modeChip'))el.className=v.className;}});
  };
  const serializeFile=async(file)=>({name:file.name,type:file.type||'audio/wav',lastModified:file.lastModified||Date.now(),data:b64(await file.arrayBuffer())});
  const fileCache=new Map();
  async function getFileEntry(file){
    if(!file)return null;
    const key=[file.name,file.size,file.lastModified].join('|');
    if(!fileCache.has(key))fileCache.set(key,serializeFile(file));
    return {key, ...(await fileCache.get(key))};
  }
  async function serializeProgram(p){
    const fileIds={};
    const samples=[];
    for(const s of (p.samples||[])){
      const f=await getFileEntry(s.file);let fileKey=f?.key||null;
      if(f&&!fileIds[fileKey]){samples.push(f);fileIds[fileKey]=true;}
    }
    const mapping=[];
    for(const m of (p.mapping||[])){
      const f=await getFileEntry(m.file);let fileKey=f?.key||null;
      if(f&&!fileIds[fileKey]){samples.push(f);fileIds[fileKey]=true;}
      const x=safeJSON(m);x.fileKey=fileKey;x.buffer=undefined;mapping.push(x);
    }
    return {id:p.id,name:p.name,category:p.category,startNote:p.startNote,mode:p.mode,settings:safeJSON(p.settings||{}),mapping,samplesMeta:(p.samples||[]).map(s=>({name:s.name,fileKey:(s.file? [s.file.name,s.file.size,s.file.lastModified].join('|'):null)})),files:samples};
  }
  async function buildProject(){
    status('SAMPLES PREPARING...');
    fileCache.clear();
    const ps=window.__DEDE_PROGRAM_API?.getCurrentProgram?null:null;
    const programs=window.__DEDE_ALL_PROGRAMS?.()||null;
    // The application keeps programs in a closure. Expose them through the compatibility hook below.
    const list=programs||[];
    const project={
      format:'DEDE_SOUND_PROJECT',version:1,createdAt:new Date().toISOString(),current:Number(window.__DEDE_CURRENT_PROGRAM?.()??0),
      controls:controlState(),fxState:safeJSON(window.__DEDE_FX_STATE?.()||{}),microTuneMap:Array.isArray(window.__DEDE_MICRO_TUNE_MAP?.())?window.__DEDE_MICRO_TUNE_MAP():[],masterTuneSemitones:Number(window.__DEDE_MASTER_TUNE?.()??0),selectedPreset:Number(window.__DEDE_SELECTED_PRESET?.()??0),
      programs:[]
    };
    for(const p of list)project.programs.push(await serializeProgram(p));
    const sf=window.__DEDE_SF2_FILE?.();
    if(sf){status('SF2 PREPARING...');project.sf2=await getFileEntry(sf);}else project.sf2=null;
    return project;
  }
  function downloadText(text,name){const blob=new Blob([text],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
  async function save(){
    try{const p=await buildProject();const base=(window.__DEDE_PROGRAM_API?.getCurrentProgram?.()?.name||'DEDE_SOUND_Project').replace(/[\\/:*?"<>|]+/g,'_').trim()||'DEDE_SOUND_Project';downloadText(JSON.stringify(p),base+'.dede');status(`SAVED • ${p.programs.length} PROGRAMS`)}catch(e){console.error(e);alert('Project save hatası: '+e.message);status('SAVE ERROR')}
  }
  function makeFile(x){return x?new File([fromB64(x.data)],x.name,{type:x.type||'audio/wav',lastModified:x.lastModified||Date.now()}):null}
  async function load(){
    const f=$('dedeProjectFile')?.files?.[0];if(!f)return;
    try{
      status('PROJECT READING...');const text=await f.text();const data=JSON.parse(text);if(data.format!=='DEDE_SOUND_PROJECT')throw new Error('Geçersiz .dede proje dosyası');
      if(typeof stopAllVoices==='function')try{stopAllVoices()}catch(_){}
      const fileMap=new Map();
      for(const x of (data.sf2?[data.sf2]:[])){if(x?.key)fileMap.set(x.key,makeFile(x));}
      for(const pp of (data.programs||[]))for(const x of (pp.files||[])){if(x?.key)fileMap.set(x.key,makeFile(x));}
      // Restore programs through the public bridge.
      const programs=window.__DEDE_ALL_PROGRAMS?.();if(!programs)throw new Error('Program motoru hazır değil. Sayfayı yenileyip projeyi tekrar içe aktarın.');
      for(let i=0;i<Math.min(programs.length,(data.programs||[]).length);i++){
        const src=data.programs[i],dst=programs[i];dst.id=src.id;dst.name=src.name;dst.category=src.category;dst.startNote=src.startNote;dst.mode=src.mode;dst.settings=src.settings||{};
        dst.samples=[];
        for(const sm of (src.samplesMeta||[])){const ff=fileMap.get(sm.fileKey);if(ff){try{const item=await loadWavFile(ff);dst.samples.push(item)}catch(e){console.warn('sample restore',sm.name,e)}}}
        const byKey=new Map(dst.samples.map(s=>[[s.file.name,s.file.size,s.file.lastModified].join('|'),s]));
        dst.mapping=(src.mapping||[]).map(m=>{const x={...m};const sm=byKey.get(m.fileKey);if(sm){x.file=sm.file;x.buffer=sm.buffer;x.name=sm.name||sm.file.name;}else{x.file=null;x.buffer=null;}return x;});
      }
      restoreControls(data.controls);
      if(data.fxState&&window.__DEDE_SET_FX_STATE)window.__DEDE_SET_FX_STATE(data.fxState);
      if(Array.isArray(data.microTuneMap)&&window.__DEDE_SET_MICRO_TUNE_MAP)window.__DEDE_SET_MICRO_TUNE_MAP(data.microTuneMap);
      if(window.__DEDE_SET_MASTER_TUNE)window.__DEDE_SET_MASTER_TUNE(Number(data.masterTuneSemitones||0));
      if(data.sf2){const sf2=fileMap.get(data.sf2.key);if(sf2){await initializeAudio();soundFont=parseSF2(await sf2.arrayBuffer());window.__DEDE_SF2_FILE_SET?.(sf2);selectedPreset=Number(data.selectedPreset||0);try{renderPresets()}catch(_){} }}
      const cur=Math.max(0,Math.min(programs.length-1,Number(data.current||0)));window.__DEDE_SET_CURRENT_PROGRAM?.(cur);activateProgram(cur);try{renderPrograms();renderCategories()}catch(_){}
      if(typeof updateFx==='function')updateFx();
      status(`IMPORTED • ${f.name}`);$('dedeProjectFile').value='';
    }catch(e){console.error(e);alert('Project import hatası: '+e.message);status('IMPORT ERROR')}
  }
  function installBridge(){
    // Global bridges for engine state. The program-bank bridge is published
    // inside the program-bank closure above, where `programs` really exists.
    if(typeof fxState!=='undefined'){window.__DEDE_FX_STATE=()=>fxState;window.__DEDE_SET_FX_STATE=o=>{Object.keys(fxState).forEach(k=>{if(k in o)fxState[k]=!!o[k]});document.querySelectorAll('.fxToggle').forEach(b=>{const k=b.dataset.fx;if(k) b.classList.toggle('on',!!fxState[k]);});};}
    if(typeof microTuneMap!=='undefined'){window.__DEDE_MICRO_TUNE_MAP=()=>[...microTuneMap];window.__DEDE_SET_MICRO_TUNE_MAP=a=>{for(let i=0;i<12;i++)microTuneMap[i]=Number(a[i]||0);try{applyMicroTuneToActiveVoices()}catch(_){};};}
    window.__DEDE_MASTER_TUNE=()=>typeof masterTuneSemitones!=='undefined'?masterTuneSemitones:0;window.__DEDE_SET_MASTER_TUNE=v=>{if(typeof masterTuneSemitones!=='undefined')masterTuneSemitones=Number(v)||0;try{applyMasterTune()}catch(_){} };
    window.__DEDE_SELECTED_PRESET=()=>typeof selectedPreset!=='undefined'?selectedPreset:0;
    window.__DEDE_SF2_FILE=()=>window.__DEDE_SF2_RAW_FILE||null;window.__DEDE_SF2_FILE_SET=f=>window.__DEDE_SF2_RAW_FILE=f;
  }
  const boot=()=>{installBridge();$('dedeSaveProject')?.addEventListener('click',save);$('dedeLoadProject')?.addEventListener('click',()=>$('dedeProjectFile')?.click());$('dedeProjectFile')?.addEventListener('change',load);const sf=$('sf2File');sf?.addEventListener('change',()=>{if(sf.files?.[0])window.__DEDE_SF2_RAW_FILE=sf.files[0]});status('READY • SAVE ALL')};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(boot,600));else setTimeout(boot,600);
})();
</script>
