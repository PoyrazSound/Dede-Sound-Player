function setupKeyEvents(
    el,
    midi,
    velocity
){

    let pointerActive=false;

    el.addEventListener(
        "pointerdown",
        async e=>{

            e.preventDefault();

            pointerActive=true;

            try{
                el.setPointerCapture(
                    e.pointerId
                );
            }catch(err){}

            el.classList.add(
                "active"
            );

            await startVoice(
                midi,
                velocity
            );
        }
    );

    el.addEventListener(
        "pointerup",
        e=>{

            e.preventDefault();

            if(!pointerActive)
                return;

            pointerActive=false;

            el.classList.remove(
                "active"
            );

            heldNotes.delete(
                midi
            );

            releaseNote(midi);
        }
    );

    el.addEventListener(
        "pointercancel",
        e=>{

            pointerActive=false;

            el.classList.remove(
                "active"
            );

            heldNotes.delete(
                midi
            );

            releaseNote(midi);
        }
    );
}

