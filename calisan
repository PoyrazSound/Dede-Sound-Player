      const val=Number(m[key]??0);
      return `<div class="vmTuneControl"><div class="vmTuneHead2"><span>${label}</span><b id="vpf_${key}">${val}${unit}</b></div><div class="vmTuneRow2"><button type="button" class="vmTuneStep" data-vpf="${key}" data-dir="-1">−</button><input id="ipf_${key}" type="range" min="${min}" max="${max}" step="${step}" value="${val}"><button type="button" class="vmTuneStep" data-vpf="${key}" data-dir="1">+</button></div></div>`;
    };
    q.innerHTML=`<div class="vmTuneCard"><div class="vmTuneName">${String(m.name||'Sample '+(selected+1)).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}</div><div class="vmTuneInfo">SAMPLE #${selected+1} • ${noteName(m.note??m.root)}<br>RANGE ${noteName(m.low)} → ${noteName(m.high)} • ROOT ${noteName(m.root)}</div></div>
      ${control('volume','VOLUME',-24,12,.1,' dB')}
      ${control('pan','PAN',-100,100,1,'')}
      ${control('coarse','COARSE',-24,24,1,' st')}
      ${control('fine','MICRO TUNE',-100,100,1,' ct')}
      ${control('attack','ATTACK',0,500,1,' ms')}
      ${control('release','RELEASE',0,2000,1,' ms')}
      <div class="vmTuneGrid2"><div class="vmTuneControl"><div class="vmTuneHead2"><span>VEL MIN</span></div><input id="ipf_velMin" class="vmTuneNumber" type="number" min="1" max="127" value="${m.velMin}"></div><div class="vmTuneControl"><div class="vmTuneHead2"><span>VEL MAX</span></div><input id="ipf_velMax" class="vmTuneNumber" type="number" min="1" max="127" value="${m.velMax}"></div></div>
      <div class="vmTuneChecks"><label><input id="ipf_solo" type="checkbox" ${m.solo?'checked':''}> SOLO</label><label><input id="ipf_mute" type="checkbox" ${m.mute?'checked':''}> MUTE</label></div>
      <button type="button" class="vmTuneReset" id="vmTuneResetFix">↺ SADECE BU SAMPLE'I SIFIRLA</button>
      <div class="vmTuneNote">Bu değerler yalnızca seçili zone/sample için tutulur. Coarse + Micro Tune birlikte sample'ın pitch değerine uygulanır.</div>`;
    const update=(key,raw)=>{
      let v=Number(raw);if(!Number.isFinite(v))v=0;
      const limits={volume:[-24,12],pan:[-100,100],coarse:[-24,24],fine:[-100,100],attack:[0,500],release:[0,2000]};
      v=clamp(v,limits[key][0],limits[key][1]);m[key]=v;
      if(key==='coarse'||key==='fine')m.tune=Number(m.coarse||0)*100+Number(m.fine||0);
      const inp=$('ipf_'+key),out=$('vpf_'+key);if(inp)inp.value=v;if(out)out.textContent=v+(key==='volume'?' dB':key==='coarse'?' st':key==='fine'?' ct':key==='attack'||key==='release'?' ms':'');
      window.__DEDE_PROGRAM_API?.refreshActiveMapping?.();
      // refreshActiveMapping may redraw the zone and replace selection; re-select by index after the update.
      setTimeout(()=>{selected=Math.min(selected,p.mapping.length-1);render();},0);
    };
    ['volume','pan','coarse','fine','attack','release'].forEach(k=>{const el=$('ipf_'+k);el?.addEventListener('input',()=>update(k,el.value));});
    q.querySelectorAll('[data-vpf]').forEach(btn=>btn.addEventListener('click',()=>{const k=btn.dataset.vpf,el=$('ipf_'+k);if(el)update(k,Number(el.value)+Number(btn.dataset.dir)*Number(el.step||1));}));
    $('ipf_velMin')?.addEventListener('input',e=>{m.velMin=clamp(Number(e.target.value)||1,1,127);if(m.velMin>m.velMax)m.velMax=m.velMin;window.__DEDE_PROGRAM_API?.refreshActiveMapping?.();setTimeout(render,0)});
    $('ipf_velMax')?.addEventListener('input',e=>{m.velMax=clamp(Number(e.target.value)||127,1,127);if(m.velMax<m.velMin)m.velMin=m.velMax;window.__DEDE_PROGRAM_API?.refreshActiveMapping?.();setTimeout(render,0)});
    $('ipf_solo')?.addEventListener('change',e=>{m.solo=e.target.checked;window.__DEDE_PROGRAM_API?.refreshActiveMapping?.()});
    $('ipf_mute')?.addEventListener('change',e=>{m.mute=e.target.checked;window.__DEDE_PROGRAM_API?.refreshActiveMapping?.()});
    $('vmTuneResetFix')?.addEventListener('click',()=>{m.volume=0;m.pan=0;m.coarse=0;m.fine=0;m.tune=0;m.attack=0;m.release=200;m.velMin=1;m.velMax=127;m.solo=false;m.mute=false;render();window.__DEDE_PROGRAM_API?.refreshActiveMapping?.()});
  }
  function bind(){
    const openBtn=$('openVisualMapping');
    openBtn?.addEventListener('click',()=>setTimeout(()=>{selected=0;render()},80));
    const zones=$('vmZones');
    zones?.addEventListener('mousedown',e=>{const z=e.target.closest('.vmZone');if(!z)return;selected=[...zones.children].indexOf(z);setTimeout(render,30)},true);
    const piano=$('vmPianoInner');
    piano?.addEventListener('mousedown',e=>{const k=e.target.closest('[data-note]');if(k){setTimeout(()=>{syncSelectedFromZones();render()},30)}},true);
    $('vmClose2')?.addEventListener('click',()=>{selected=-1});
    setInterval(()=>{const modal=$('visualMappingModal');if(modal?.classList.contains('open')){if(selected<0)syncSelectedFromZones();if(!$('vmInspectorContent')?.querySelector('.vmTuneCard'))render()}},250);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();
})();
</script>
\n\n\n<script id="dede-vm-selection-engine-v2">
(()=>{
  const $=id=>document.getElementById(id);
  const modal=()=>$('visualMappingModal');
