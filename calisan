<script id="dede-reverb-functional-controls">
(()=>{
  const $=id=>document.getElementById(id);
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const maps=[
    {id:'fx_rev_predelay',min:0,max:180,step:1,label:'PRE DELAY'},
    {id:'fx_rev_decay',min:.1,max:12,step:.1,label:'DECAY'},
    {id:'fx_rev_size',min:.1,max:1,step:.01,label:'SIZE'},
    {id:'fx_rev_damp',min:0,max:1,step:.01,label:'DAMPING'},
    {id:'fx_rev_diff',min:0,max:1,step:.01,label:'DIFFUSION'},
    {id:'fx_rev_mix',min:0,max:1,step:.01,label:'MIX'}
  ];
  const pos=[[12.3,70],[24.5,70],[37.0,70],[49.2,70],[61.4,70],[73.5,70]];
  function dispatch(id){
    const el=$(id); if(!el) return;
    try{el.dispatchEvent(new Event('input',{bubbles:true}));}catch(e){}
    try{el.dispatchEvent(new Event('change',{bubbles:true}));}catch(e){}
    try{if(typeof updateFx==='function') updateFx();}catch(e){console.warn('reverb update',e)}
  }
  let syncingOverlay=false;
  function ensureOverlay(){
    if(syncingOverlay) return;
    syncingOverlay=true;
    try{
      document.querySelectorAll('#fxTab-reverb .reverbHardware').forEach(mod=>{
        const hero=mod.querySelector('.fxImageHero'); if(!hero) return;
        const existing=[...hero.querySelectorAll('.dedeRevKnobHit')];
        // Do not rebuild the overlay when it is already complete. Rebuilding
        // inside a body MutationObserver creates a self-triggering mutation loop.
        if(existing.length===maps.length){
          existing.forEach((hit,i)=>{
            hit.dataset.reverbParam=maps[i].id;
            hit.title=maps[i].label+' • Drag / Wheel';
            hit.setAttribute('aria-label',maps[i].label);
            hit.style.left=pos[i][0]+'%';
            hit.style.top=pos[i][1]+'%';
          });
          return;
        }
        existing.forEach(x=>x.remove());
        maps.forEach((m,i)=>{
          const hit=document.createElement('button');
          hit.type='button'; hit.className='dedeRevKnobHit'; hit.dataset.reverbParam=m.id;
          hit.title=m.label+' • Drag / Wheel'; hit.setAttribute('aria-label',m.label);
          hit.style.left=pos[i][0]+'%'; hit.style.top=pos[i][1]+'%';
          hero.appendChild(hit);
        });
      });
    }finally{ syncingOverlay=false; }
  }
  let drag=null;
  document.addEventListener('pointerdown',e=>{
    const hit=e.target.closest?.('.dedeRevKnobHit'); if(!hit) return;
    const id=hit.dataset.reverbParam, el=$(id); if(!el) return;
    drag={hit,id,startY:e.clientY,startVal:Number(el.value)};
    hit.setPointerCapture?.(e.pointerId); e.preventDefault(); e.stopPropagation();
  },true);
  document.addEventListener('pointermove',e=>{
    if(!drag) return;
    const m=maps.find(x=>x.id===drag.id); const el=$(drag.id); if(!m||!el)return;
    const nv=drag.startVal-(e.clientY-drag.startY)*(m.max-m.min)/220;
    const stepped=Math.round(nv/m.step)*m.step;
    el.value=String(clamp(stepped,m.min,m.max));
    dispatch(m.id);
    e.preventDefault();
  },true);
  const stop=()=>{drag=null};
  document.addEventListener('pointerup',stop,true); document.addEventListener('pointercancel',stop,true);
  document.addEventListener('wheel',e=>{
    const hit=e.target.closest?.('.dedeRevKnobHit'); if(!hit)return;
    const m=maps.find(x=>x.id===hit.dataset.reverbParam); const el=$(hit.dataset.reverbParam); if(!m||!el)return;
    const dir=e.deltaY<0?1:-1;
    const nv=Number(el.value)+dir*m.step*5;
    el.value=String(clamp(Math.round(nv/m.step)*m.step,m.min,m.max));
    dispatch(m.id); e.preventDefault(); e.stopPropagation();
  },{capture:true,passive:false});

  document.addEventListener('click',e=>{
    const btn=e.target.closest?.('#fxRevModeBar .modeChip'); if(btn){
      const bar=btn.parentElement, sel=$('fx_rev_type');
      const arr=bar?[...bar.querySelectorAll('.modeChip')]:[];
      if(sel&&bar){const i=arr.indexOf(btn); if(sel.options[i]){sel.value=sel.options[i].value;}}
      arr.forEach(x=>x.classList.remove('active')); btn.classList.add('active');
      dispatch('fx_rev_type'); return;
    }
    const reset=e.target.closest?.('.reverbHardware [data-reverb-reset]');
    if(reset){maps.forEach(m=>{const el=$(m.id); if(el) el.value=el.defaultValue; dispatch(m.id);});}
  },true);

  const inputIds=maps.map(m=>m.id).concat(['fx_rev_low','fx_rev_high','fx_rev_width','fx_rev_type']);
  document.addEventListener('input',e=>{if(e.target.id&&inputIds.includes(e.target.id)) {try{if(typeof updateFx==='function')updateFx()}catch(_){} }},true);
  document.addEventListener('change',e=>{if(e.target.id&&inputIds.includes(e.target.id)) {try{if(typeof updateFx==='function')updateFx()}catch(_){} }},true);

  const observer=new MutationObserver(()=>ensureOverlay());
  const boot=()=>{ensureOverlay(); observer.observe(document.body,{childList:true,subtree:true});};
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot,{once:true}); else boot();
  setTimeout(ensureOverlay,200); setTimeout(ensureOverlay,700); setTimeout(ensureOverlay,1500);
})();
</script>


<!-- TRUE PER-NOTE INSPECTOR FIX: selection and controls are keyed to the exact mapping zone index. -->
<style id="true-per-note-inspector-style">
  .vmZone.trueActive{opacity:1!important;box-shadow:0 0 0 2px #ffc72c,0 0 14px rgba(255,199,44,.28)!important}
</style>
<script id="true-per-note-inspector-fix">
(()=>{
  const $=id=>document.getElementById(id);
  const MIN=36,MAX=96;
  let active=-1, busy=false;
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const noteName=n=>{const names=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];n=Number(n)||0;return names[((n%12)+12)%12]+(Math.floor(n/12)-1)};
  const program=()=>window.__DEDE_PROGRAM_API?.getCurrentProgram?.()||null;
  const normalize=m=>{
    m.volume=Number(m.volume??0); m.pan=Number(m.pan??0); m.coarse=Number(m.coarse??0);
    m.fine=Number(m.fine??0); m.attack=Number(m.attack??0); m.release=Number(m.release??200);
    m.velMin=Number(m.velMin??1); m.velMax=Number(m.velMax??127); m.solo=!!m.solo; m.mute=!!m.mute;
    m.tune=Number(m.coarse||0)*100+Number(m.fine||0);
    return m;
  };
  const mark=()=>{
    const z=$('vmZones'); if(!z)return;
    [...z.children].forEach((el,i)=>{
      el.classList.toggle('sel',i===active);
      el.classList.toggle('trueActive',i===active);
      el.dataset.trueNoteIndex=i;
    });
    const p=program();
    if(p?.mapping?.[active]){
      const s=$('vmStatus'); if(s)s.textContent=`${noteName(p.mapping[active].note??p.mapping[active].root)} seçildi • SAMPLE #${active+1}`;
    }
  };
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function render(){
    const q=$('vmInspectorContent'),p=program();
    if(!q||!p?.mapping?.length)return;
    if(active<0||active>=p.mapping.length){q.innerHTML='<div class="vmTuneNote">Mapte bir nota/sample seç.</div>';return;}
    const m=normalize(p.mapping[active]);
    const control=(key,label,min,max,step,unit)=>{
      const v=Number(m[key]);
      return `<div class="vmTuneControl"><div class="vmTuneHead2"><span>${label}</span><b id="true_${key}_out">${v}${unit}</b></div><div class="vmTuneRow2"><button type="button" class="vmTuneStep" data-true-key="${key}" data-dir="-1">−</button><input id="true_${key}" type="range" min="${min}" max="${max}" step="${step}" value="${v}"><button type="button" class="vmTuneStep" data-true-key="${key}" data-dir="1">+</button></div></div>`;
    };
    q.innerHTML=`<div class="vmTuneCard"><div class="vmTuneName">${esc(m.name||('Sample '+(active+1)))}</div><div class="vmTuneInfo">MIDI ${m.note??m.root} • ${noteName(m.note??m.root)}<br>RANGE ${noteName(m.low)} → ${noteName(m.high)} • ROOT ${noteName(m.root)}</div></div>
      ${control('volume','VOLUME',-24,12,.1,' dB')}
      ${control('pan','PAN',-100,100,1,'')}
      ${control('coarse','COARSE',-24,24,1,' st')}
      ${control('fine','MICRO TUNE',-100,100,1,' ct')}
      ${control('attack','ATTACK',0,500,1,' ms')}
      ${control('release','RELEASE',0,2000,1,' ms')}
      <div class="vmTuneGrid2"><div class="vmTuneControl"><div class="vmTuneHead2"><span>VEL MIN</span></div><input id="true_velMin" class="vmTuneNumber" type="number" min="1" max="127" value="${m.velMin}"></div><div class="vmTuneControl"><div class="vmTuneHead2"><span>VEL MAX</span></div><input id="true_velMax" class="vmTuneNumber" type="number" min="1" max="127" value="${m.velMax}"></div></div>
      <div class="vmTuneChecks"><label><input id="true_solo" type="checkbox" ${m.solo?'checked':''}> SOLO</label><label><input id="true_mute" type="checkbox" ${m.mute?'checked':''}> MUTE</label></div>
      <button type="button" class="vmTuneReset" id="true_reset">↺ SADECE BU NOTAYI SIFIRLA</button>
      <div class="vmTuneNote">Bu panel yalnızca seçili MIDI notasının mapping zone'una aittir. Başka nota seçildiğinde onun kendi değerleri gösterilir.</div>`;
    const fmt=(k,v)=>v+(k==='volume'?' dB':k==='coarse'?' st':k==='fine'?' ct':k==='attack'||k==='release'?' ms':'');
    const update=(k,raw)=>{
      if(busy)return;
      let v=Number(raw); if(!Number.isFinite(v))v=0;
      const lim={volume:[-24,12],pan:[-100,100],coarse:[-24,24],fine:[-100,100],attack:[0,500],release:[0,2000]}[k];
      if(lim)v=clamp(v,lim[0],lim[1]);
      const p2=program(); const target=p2?.mapping?.[active]; if(!target)return;
      target[k]=v;
      if(k==='attack'||k==='release') target._customEnvelope=true;
      if(k==='coarse'||k==='fine')target.tune=Number(target.coarse||0)*100+Number(target.fine||0);
      const inp=$('true_'+k),out=$('true_'+k+'_out'); if(inp)inp.value=v;if(out)out.textContent=fmt(k,v);
      // Do not reselect or rebuild the mapping. The exact zone object is updated in place.
      try{window.__DEDE_PROGRAM_API?.savePrograms?.()}catch(_){ }
    };
    ['volume','pan','coarse','fine','attack','release'].forEach(k=>$('true_'+k)?.addEventListener('input',e=>update(k,e.target.value)));
    q.querySelectorAll('[data-true-key]').forEach(b=>b.addEventListener('click',()=>{const k=b.dataset.trueKey,i=$('true_'+k);if(i)update(k,Number(i.value)+Number(b.dataset.dir)*Number(i.step||1))}));
    $('true_velMin')?.addEventListener('input',e=>{const p2=program(),m2=p2?.mapping?.[active];if(!m2)return;m2.velMin=clamp(Number(e.target.value)||1,1,127);if(m2.velMin>Number(m2.velMax||127))m2.velMax=m2.velMin;});
    $('true_velMax')?.addEventListener('input',e=>{const p2=program(),m2=p2?.mapping?.[active];if(!m2)return;m2.velMax=clamp(Number(e.target.value)||127,1,127);if(m2.velMax<Number(m2.velMin||1))m2.velMin=m2.velMax;});
    $('true_solo')?.addEventListener('change',e=>{const p2=program(),m2=p2?.mapping?.[active];if(!m2)return;m2.solo=e.target.checked;if(m2.solo)p2.mapping.forEach((x,i)=>{if(i!==active)x.solo=false});});
    $('true_mute')?.addEventListener('change',e=>{const p2=program(),m2=p2?.mapping?.[active];if(m2)m2.mute=e.target.checked;});
    $('true_reset')?.addEventListener('click',()=>{const p2=program(),m2=p2?.mapping?.[active];if(!m2)return;Object.assign(m2,{volume:0,pan:0,coarse:0,fine:0,tune:0,attack:0,release:200,_customEnvelope:false,velMin:1,velMax:127,solo:false,mute:false});render();mark();});
  }
  function selectIndex(i){
    const p=program(); if(!p?.mapping?.[i])return;
    active=i; mark(); render();
  }
  function noteFromText(t){
    const m=String(t||'').trim().match(/^([A-G](?:#)?)(-?\d+)$/); if(!m)return null;
    const sem={C:0,'C#':1,D:2,'D#':3,E:4,F:5,'F#':6,G:7,'G#':8,A:9,'A#':10,B:11};
    return sem[m[1]]+12*(Number(m[2])+1);
  }
  function bind(){
    const z=$('vmZones');
    if(z&&!z.dataset.truePerNote){
      z.dataset.truePerNote='1';
      z.addEventListener('click',e=>{const el=e.target.closest('.vmZone');if(!el)return;const i=[...z.children].indexOf(el);if(i>=0)selectIndex(i);},true);
    }
    const p=$('vmPianoInner');
    if(p&&!p.dataset.truePerNote){
      p.dataset.truePerNote='1';
      p.addEventListener('click',e=>{const key=e.target.closest('.vmWhite,.vmBlack');if(!key)return;const n=noteFromText(key.querySelector('span')?.textContent);if(n==null)return;const pr=program();let i=(pr?.mapping||[]).findIndex(m=>Number(m.note)===n);if(i<0)i=(pr?.mapping||[]).findIndex(m=>n>=Number(m.low)&&n<=Number(m.high));if(i>=0)selectIndex(i);},true);
    }
    const open=$('openVisualMapping');
    if(open&&!open.dataset.truePerNote){open.dataset.truePerNote='1';open.addEventListener('click',()=>setTimeout(()=>{const pr=program();if(pr?.mapping?.length)selectIndex(0)},120),true);}
    setInterval(()=>{
      const modal=$('visualMappingModal'); if(!modal?.classList.contains('open'))return;
      const pr=program(); if(!pr?.mapping?.length)return;
      if(active<0||active>=pr.mapping.length)active=0;
      mark();
      if(!$('vmInspectorContent')?.querySelector('#true_volume'))render();
    },250);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>setTimeout(bind,200));else setTimeout(bind,200);
})();
</script>




