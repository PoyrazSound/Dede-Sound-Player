function setFxPreset(name){

    const preset=
        fxPresets[name]||
        fxPresets.alloff;

    Object.keys(fxState).forEach(k=>{
        fxState[k]=!!preset[k];
    });

    document.querySelectorAll(".fxToggle")
        .forEach(btn=>{

            const fx=btn.dataset.fx;

            btn.classList.toggle(
                "on",
                !!fxState[fx]
            );

            btn.textContent=
                fxState[fx] ? "ON" : "OFF";
        });

    updateFx();
}

