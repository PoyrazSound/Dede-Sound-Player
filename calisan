<!DOCTYPE html>

<html lang="tr">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1.0" name="viewport"/>
<title>Dede Sound Premium SF2 + WAV Workstation v9.2 V6</title>
<style>
*{box-sizing:border-box}

html,body{
    margin:0;
    min-height:100%;
}

body{
    background:
        radial-gradient(circle at 50% -10%,#3b3b3b 0,#111 42%,#020202 82%);
    color:#eee;
    font-family:Arial,Helvetica,sans-serif;
    padding:18px;
}

.workstation{
    max-width:1600px;
    margin:auto;
    background:linear-gradient(145deg,#292929,#101010 35%,#050505);
    border:1px solid #4b4b4b;
    border-radius:20px;
    padding:18px;
    box-shadow:
        0 30px 80px #000,
        inset 0 1px 0 #ffffff18;
}

.header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:4px 8px 18px;
}

.logo{
    display:flex;
    align-items:center;
    gap:14px;
}

.logoBox{
    width:48px;
    height:48px;
    display:grid;
    place-items:center;
    border-radius:8px;
    background:linear-gradient(145deg,#f0d57e,#805b20);
    color:#111;
    font-weight:bold;
    font-size:16px;
}

.brand{
    font-size:21px;
    letter-spacing:4px;
    font-weight:bold;
}

.subtitle{
    color:#c69d4d;
    font-size:8px;
    letter-spacing:3px;
    margin-top:4px;
}

.status{
    font-size:9px;
    color:#888;
}

.led{
    width:8px;
    height:8px;
    display:inline-block;
    border-radius:50%;
    background:#555;
    margin-right:7px;
}

.led.ready{
    background:#cba24e;
    box-shadow:0 0 12px #cba24e;
}

.main{
    display:grid;
    grid-template-columns:240px minmax(0,1fr) 280px;
    gap:14px;
}

.panel,
.display,
.performance{
    background:linear-gradient(#191919,#090909);
    border:1px solid #303030;
    border-radius:11px;
}

.panel{
    padding:15px;
}

.display{
    min-height:430px;
    padding:18px;
    background:
        radial-gradient(circle at 50% 0,#333c37,#151918 55%,#070808);
    box-shadow:inset 0 0 40px #000;
}

.sectionTitle{
    color:#bd9448;
    font-size:8px;
    font-weight:bold;
    letter-spacing:2px;
    margin-bottom:12px;
}

.button{
    width:100%;
    padding:10px;
    margin:4px 0;
    border-radius:6px;
    border:1px solid #3b3b3b;
    background:linear-gradient(#292929,#111);
    color:#ddd;
    cursor:pointer;
    font-size:9px;
}

.button:hover{
    border-color:#d1a956;
    color:#e2c16b;
}

.gold{
    background:linear-gradient(#d9b763,#77531f);
    border-color:#d7b45c;
    color:#111;
    font-weight:bold;
}

.displayTop{
    display:flex;
    justify-content:space-between;
    color:#818783;
    font-size:8px;
    letter-spacing:1.5px;
}

.presetName{
    margin-top:15px;
    font-size:24px;
    font-weight:600;
}

.presetInfo{
    color:#c29a4d;
    margin-top:4px;
    font-size:9px;
    letter-spacing:1px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:9px;
    margin-top:15px;
}

.card{
    height:90px;
    position:relative;
    overflow:hidden;
    border:1px solid #373737;
    border-radius:7px;
    background:#080808;
    cursor:pointer;
}

.card:hover,
.card.active{
    border-color:#d3ae59;
    box-shadow:0 0 18px #c49a4428;
}

.instrumentArt{
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at 25% 20%,#927039,#3c2f1b 18%,transparent 45%),
        linear-gradient(135deg,#292929,#050505);
}

.cardText{
    position:absolute;
    z-index:2;
    bottom:9px;
    left:9px;
}

.cardName{
    font-weight:bold;
    font-size:10px;
}

.cardType{
    color:#c39b50;
    font-size:7px;
    margin-top:3px;
}

/* ================= FX ================= */

.fxRackContainer{
    margin-top:15px;
    background:#0d0d0d;
    border:1px solid #333;
    border-radius:8px;
    padding:12px;
}

.fxCategories{
    display:flex;
    gap:5px;
    margin-bottom:10px;
    flex-wrap:wrap;
}

.fxTabBtn{
    background:#1c1c1c;
    border:1px solid #444;
    color:#aaa;
    font-size:7px;
    padding:6px 9px;
    border-radius:4px;
    cursor:pointer;
}

.fxTabBtn.active{
    background:#cba24e;
    color:#111;
    font-weight:bold;
    border-color:#e0be6c;
}

.fxGrid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:8px;
}

.fxModule{
    background:#141414;
    border:1px solid #2b2b2b;
    border-radius:6px;
    padding:8px;
}

.fxModuleHeader{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:6px;
}

.fxTitle{
    font-size:8px;
    color:#d0aa54;
    font-weight:bold;
}

.fxToggle{
    min-width:42px;
    font-size:7px;
    padding:3px 6px;
    background:#222;
    border:1px solid #444;
    color:#777;
    border-radius:3px;
    cursor:pointer;
}

.fxToggle.on{
    background:#3a2c12;
    color:#e7c878;
    border-color:#caa04b;
}

.fxControls{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:5px;
    font-size:7px;
    color:#888;
}

.fxControlItem label{
    display:block;
    margin-bottom:3px;
}

.fxControlItem select,
.fxControlItem input{
    width:100%;
    background:#080808;
    color:#ccc;
    border:1px solid #333;
    border-radius:3px;
    font-size:7px;
    padding:3px;
}

.fxControlItem input[type="range"]{
    padding:0;
}

/* MASTER */

.knobs{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px 8px;
}

.knobContainer{
    text-align:center;
}

.knob{
    width:45px;
    height:45px;
    margin:auto;
    border-radius:50%;
    background:
        radial-gradient(circle at 32% 27%,#555,#252525 45%,#090909 75%);
    border:2px solid #3a3a3a;
    box-shadow:
        0 4px 10px #000,
        inset 0 2px 3px #ffffff15;
    position:relative;
}

.knobPointer{
    position:absolute;
    width:3px;
    height:11px;
    background:#d5ae5b;
    left:50%;
    top:3px;
    transform-origin:50% 20px;
    transform:translateX(-50%) rotate(0deg);
}

.knobLabel{
    margin-top:4px;
    color:#888;
    font-size:7px;
    letter-spacing:1px;
}

.knobValue{
    color:#bd9549;
    font:7px monospace;
    margin-top:2px;
}

.meter{
    height:10px;
    margin-top:9px;
    background:#050505;
    border:1px solid #333;
    border-radius:3px;
    overflow:hidden;
}

.meterFill{
    height:100%;
    width:0%;
    background:linear-gradient(
        90deg,
        #675928,
        #c5a34f,
        #e4c66c
    );
}

.lower{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:14px;
    margin-top:14px;
}

.performance{
    padding:15px;
}

.sliderGrid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.sliderItem label{
    display:block;
    color:#888;
    font-size:7px;
    letter-spacing:1px;
    margin-bottom:7px;
}

.sliderItem input{
    width:100%;
    accent-color:#caa04b;
}

.switches{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
}

.switch{
    position:relative;
    padding:9px;
    border:1px solid #333;
    border-radius:5px;
    background:linear-gradient(#181818,#0b0b0b);
    color:#777;
    cursor:pointer;
    font-size:8px;
}

.switch.on{
    border-color:#caa04b;
    color:#e7c878;
    background:linear-gradient(#3a2c12,#1c1509);
}

.midiMonitor{
    background:#070707;
    border:1px solid #292929;
    padding:10px;
    border-radius:5px;
    color:#aaa;
    font:9px Consolas,monospace;
    line-height:1.5;
}

.fileInfo{
    color:#777;
    font-size:8px;
    line-height:1.5;
    margin-top:10px;
}

.mappingList{
    max-height:150px;
    overflow:auto;
    margin-top:10px;
    background:#050505;
    border:1px solid #292929;
    border-radius:5px;
    padding:7px;
    font:8px Consolas,monospace;
    color:#aaa;
}

.mappingRow{
    display:flex;
    justify-content:space-between;
    padding:3px 2px;
    border-bottom:1px solid #171717;
}

.mappingNote{
    color:#d0aa54;
}

/* ================= PERFORMANCE BENDERS ================= */
.performanceKeyboardRow{display:flex;align-items:stretch;gap:10px;margin-top:12px}
.performanceBenders{width:106px;flex:0 0 106px;display:flex;flex-direction:row;justify-content:center;align-items:stretch;gap:7px;padding:7px 6px;background:linear-gradient(180deg,#111,#070707);border:1px solid #303030;border-radius:9px;min-height:0;box-shadow:inset 0 1px #ffffff08,0 6px 18px #0008}
.benderUnit{width:45px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:3px;min-height:0}
.benderTitle{font-size:6.5px;letter-spacing:.55px;color:#c9a04b;text-align:center;font-weight:800;white-space:nowrap}
.benderTrack{position:relative;width:34px;height:142px;display:flex;align-items:center;justify-content:center;border:1px solid #252525;border-radius:6px;background:linear-gradient(90deg,#070707,#171717,#070707);box-shadow:inset 0 0 7px #000}
.benderTrack:before{content:"";position:absolute;left:50%;top:8px;bottom:8px;width:4px;transform:translateX(-50%);background:linear-gradient(#101010,#343434 50%,#101010);border:1px solid #050505;border-radius:4px;box-shadow:inset 1px 0 #ffffff12}
.benderTrack input[type=range]{position:absolute;z-index:2;appearance:none;-webkit-appearance:none;width:130px;height:22px;transform:rotate(-90deg);background:transparent;accent-color:#c9a04b;cursor:pointer}
.benderTrack input[type=range]::-webkit-slider-runnable-track{height:5px;background:transparent;border:0}
.benderTrack input[type=range]::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:18px;height:28px;border-radius:3px;background:linear-gradient(180deg,#e0bd67,#98722e 52%,#5c431a);border:1px solid #17130b;box-shadow:0 1px 4px #000,0 0 5px #c99b3a33;cursor:grab}
.benderTrack input[type=range]::-moz-range-track{height:5px;background:transparent;border:0}
.benderTrack input[type=range]::-moz-range-thumb{width:18px;height:28px;border-radius:3px;background:linear-gradient(#e0bd67,#98722e);border:1px solid #17130b;box-shadow:0 1px 4px #000;cursor:grab}
.benderCenterMark{position:absolute;z-index:1;left:5px;right:5px;top:50%;height:1px;background:#70582d;pointer-events:none;box-shadow:0 0 3px #b58d3a33}
.benderArrow{width:26px;height:14px;display:grid;place-items:center;border:1px solid #3d3d3d;border-radius:3px;background:linear-gradient(#303030,#0d0d0d);color:#b99a57;font:9px Arial,sans-serif;line-height:1;box-shadow:inset 0 1px #ffffff0a;user-select:none}
.benderValue{font:6.5px monospace;color:#999;min-height:9px}
.benderHint{font:5.5px monospace;color:#5f5f5f;text-align:center;line-height:1.2;white-space:nowrap}
@media(max-width:700px){.performanceKeyboardRow{display:flex;overflow-x:auto}.performanceBenders{width:106px;flex:0 0 106px}.keyboard{min-width:760px}}

/* ================= REAL 61 KEY KEYBOARD ================= */

.keyboardPanel{
    margin-top:14px;
    padding:14px;
    background:#101010;
    border:1px solid #303030;
    border-radius:11px;
}

.keyboardHeader{
    display:flex;
    justify-content:space-between;
    margin-bottom:10px;
}

.keyboard{
    height:172px;
    min-width:900px;
    position:relative;
    background:#050505;
    border-radius:7px;
    overflow:hidden;
    user-select:none;
    touch-action:none;
    padding:6px;
}

.whiteKeys{
    position:absolute;
    left:6px;
    right:6px;
    top:6px;
    bottom:6px;
    display:flex;
}

.whiteKey{
    position:relative;
    flex:1;
    height:100%;
    background:
        linear-gradient(90deg,#f7f7f7,#ddd 55%,#aaa);
    border-left:1px solid #444;
    border-right:1px solid #222;
    border-bottom:2px solid #111;
    border-radius:0 0 5px 5px;
    cursor:pointer;
    z-index:1;
}

.whiteKey.active{
    background:
        linear-gradient(
            180deg,
            #f0d985,
            #c29337 55%,
            #79551f
        );
    box-shadow:
        inset 0 -5px 8px #0005,
        0 0 8px #c9a04b66;
    transform:translateY(1px);
}

.keyLabel{
    position:absolute;
    left:0;
    bottom:7px;
    width:100%;
    text-align:center;
    color:#555;
    font-size:7px;
    pointer-events:none;
}

.blackKeys{
    position:absolute;
    left:6px;
    right:6px;
    top:6px;
    height:112px;
    pointer-events:none;
    z-index:10;
}

.blackKey{
    position:absolute;
    top:0;
    height:112px;
    width:26px;
    transform:translateX(-50%);
    background:
        linear-gradient(
            90deg,
            #020202,
            #111 18%,
            #454545 50%,
            #101010 82%,
            #000
        );
    border:1px solid #000;
    border-radius:0 0 6px 6px;
    box-shadow:
        0 5px 7px #000,
        inset 1px 0 1px #ffffff15;
    cursor:pointer;
    pointer-events:auto;
    z-index:20;
}

.blackKey.active{
    background:
        linear-gradient(
            180deg,
            #e6ca72,
            #a87828 50%,
            #4d3410
        );
    box-shadow:
        0 2px 4px #000,
        0 0 10px #d4ad55aa;
    transform:translateX(-50%) translateY(2px);
}

.footer{
    display:flex;
    justify-content:space-between;
    color:#555;
    font-size:7px;
    padding:10px 3px 0;
    letter-spacing:1px;
}

@media(max-width:1150px){
    .main{grid-template-columns:1fr}
    .lower{grid-template-columns:1fr}
}

@media(max-width:800px){
    .fxGrid{
        grid-template-columns:1fr;
    }

    .cards{
        grid-template-columns:repeat(2,1fr);
    }
}

/* ================= MICRO TUNING ================= */
.microTunePanel{margin-top:18px;padding:12px;background:linear-gradient(145deg,#0e1012,#17191c 55%,#0a0c0e);border:1px solid #3b4147;border-radius:10px;box-shadow:inset 0 1px #ffffff10,0 12px 28px #0008}
.microTuneHead{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
.microTuneTitle{font-size:11px;font-weight:900;letter-spacing:2px;color:#e4c66f}
.microTuneStatus{font:8px monospace;color:#7f858b}
.microTuneInfo{font-size:8px;color:#777d83;margin-bottom:9px;line-height:1.45}
.microTuneKeys{position:relative;width:100%;height:112px;margin:8px 0 2px;overflow:hidden;border-radius:6px;background:#060708;box-shadow:inset 0 0 0 1px #25292d,inset 0 5px 12px #000}
.microTuneWhiteRow{position:absolute;inset:0;display:grid;grid-template-columns:repeat(7,1fr);gap:1px;padding:0 2px}
.microTuneWhiteKey{position:relative;min-width:0;height:100%;padding:0 2px 7px;border:1px solid #777;background:linear-gradient(180deg,#fff,#e7e7e7 62%,#bdbdbd);border-radius:0 0 5px 5px;color:#333;cursor:pointer;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;font-size:8px;font-weight:900;box-shadow:inset 0 -5px 8px #0002,0 2px 2px #000;z-index:1;transition:.12s}
.microTuneWhiteKey:hover{background:linear-gradient(180deg,#fff7cf,#e8d487 62%,#a97c2c);border-color:#d4b25e}
.microTuneWhiteKey.selected{background:linear-gradient(180deg,#fff0a1,#d2a845 62%,#7b541c);border-color:#ffeaa0;box-shadow:inset 0 -5px 8px #0004,0 0 12px #d5ad4d88}
.microTuneBlackRow{position:absolute;inset:0;z-index:5;pointer-events:none}
.microTuneBlackKey{position:absolute;top:0;width:11.5%;height:68%;transform:translateX(-50%);padding:0 1px 6px;border:1px solid #000;border-radius:0 0 5px 5px;background:linear-gradient(90deg,#050505,#292929 45%,#070707);color:#ddd;cursor:pointer;pointer-events:auto;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;font-size:7px;font-weight:900;box-shadow:0 3px 5px #000,inset 0 1px #7774}
.microTuneBlackKey:hover{background:linear-gradient(90deg,#1a1a1a,#80682e 48%,#15110a);border-color:#d2ae58}
.microTuneBlackKey.selected{background:linear-gradient(90deg,#4d3a16,#d2a84b 48%,#4b3511);border-color:#ffeaa0;box-shadow:0 0 12px #d5ad4d88,0 3px 5px #000}
.microTuneKey .mtVal{display:block;margin-top:2px;font:7px monospace;line-height:1;color:#686868;white-space:nowrap}
.microTuneBlackKey .mtVal{color:#aaa}
.microTuneWhiteKey.assigned .mtVal,.microTuneBlackKey.assigned .mtVal{color:#d9b85e}
.microTuneKey.assigned{outline:1px solid #d2a84b;outline-offset:-2px}
.microTuneEditor{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;margin-top:10px;padding:9px;background:#090b0d;border:1px solid #292e33;border-radius:7px}
.microTuneEditor button{height:31px;padding:0 9px;background:linear-gradient(#34383d,#111315);border:1px solid #50565c;border-radius:5px;color:#ddd;cursor:pointer;font-size:9px;font-weight:800}
.microTuneEditor button:hover{border-color:#d0a94f;color:#f1d178}
.microTuneEditor input[type=range]{width:100%;accent-color:#d0aa54}
.microTuneValue{min-width:64px;text-align:center;font:10px monospace;color:#e6c76c}
.microTuneReset{width:100%;margin-top:7px;height:30px;background:#111315;border:1px solid #393e43;border-radius:5px;color:#888;cursor:pointer;font-size:8px;letter-spacing:1px}
.microTuneReset:hover{border-color:#d0a94f;color:#e6c76c}
@media(max-width:800px){.microTuneKeys{height:96px}.microTuneBlackKey{height:62%;width:12.5%}}

/* ================= FX STUDIO MODAL ================= */
.fxStudioLaunch{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    margin-top:10px;
    min-height:40px;
    font-size:9px;
    letter-spacing:1.5px;
    font-weight:800;
    color:#e8c86e;
    background:
        radial-gradient(circle at 50% 0%,#3d3219 0,#18140b 45%,#090909 100%);
    border:1px solid #a88338;
    box-shadow:0 0 0 1px #201b10 inset,0 0 14px #c9a14a20,inset 0 1px #ffffff12;
    overflow:hidden;
}
.fxStudioLaunch:before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(110deg,transparent 20%,#fff5b522 45%,transparent 70%);
    transform:translateX(-120%);
    transition:transform .65s ease;
}
.fxStudioLaunch:hover:before{transform:translateX(120%);}
.fxStudioLaunch:hover{
    border-color:#e0bd63;
    box-shadow:0 0 18px #d1aa4d44,inset 0 0 14px #d1aa4d12;
}
.fxLaunchIcon{font-size:14px;text-shadow:0 0 8px #e1bd62;}
.fxLaunchLed{width:6px;height:6px;border-radius:50%;background:#333;border:1px solid #555;box-shadow:0 0 0 transparent;}
.fxLaunchLed.active{background:#e2bd5e;border-color:#f4d37a;box-shadow:0 0 9px #e0b84e;}

.fxStudioModal{
    position:fixed;
    inset:0;
    z-index:9999;
    display:none;
    align-items:center;
    justify-content:center;
    padding:24px;
    background:rgba(0,0,0,.78);
    backdrop-filter:blur(7px);
}
.fxStudioModal.open{display:flex;animation:fxFadeIn .18s ease-out;}
@keyframes fxFadeIn{from{opacity:0}to{opacity:1}}

.fxStudioWindow{
    width:min(1120px,96vw);
    max-height:92vh;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    background:linear-gradient(145deg,#171717,#090909 72%);
    border:1px solid #67532d;
    border-radius:12px;
    box-shadow:0 24px 80px #000,0 0 35px #d0a84b22,inset 0 1px #ffffff12;
    transform:translateY(8px) scale(.985);
    animation:fxWindowIn .22s ease-out forwards;
}
@keyframes fxWindowIn{to{transform:translateY(0) scale(1)}}
.fxStudioHeader{
    min-height:62px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:10px 15px;
    border-bottom:1px solid #292929;
    background:linear-gradient(180deg,#191919,#101010);
}
.fxStudioBrand{display:flex;align-items:center;gap:10px;}
.fxStudioLogo{
    width:36px;height:36px;display:grid;place-items:center;border-radius:6px;
    color:#e0b75b;font-weight:900;font-size:12px;
    border:1px solid #80642e;background:#111;box-shadow:inset 0 0 12px #c39b5020,0 0 10px #c39b5015;
}
