async function initMIDI(){
    const monitor=$("midiMonitor");
    if(!navigator.requestMIDIAccess){
        if(monitor) monitor.innerHTML="MIDI: Web MIDI desteklenmiyor.<br>Chrome/Edge kullan ve HTML dosyasını localhost üzerinden aç.";
        return;
    }
    if(!window.isSecureContext && location.protocol!=="file:"){
        if(monitor) monitor.innerHTML="MIDI: GÜVENLİ BAĞLANTI GEREKLİ.<br>Sayfayı localhost/HTTPS üzerinden aç.";
        return;
    }
    try{
        midiAccess=await navigator.requestMIDIAccess({sysex:false});
        const bindInputs=()=>{
            let count=0;
            midiAccess.inputs.forEach(input=>{input.onmidimessage=handleMIDI;count++;});
            if(monitor){
                const names=[]; midiAccess.inputs.forEach(i=>names.push(i.name||"MIDI INPUT"));
                monitor.innerHTML=count?"MIDI: READY • "+count+" INPUT<br>"+names.map(n=>String(n).replace(/[<>]/g,"")).join("<br>"):"MIDI: INPUT YOK<br>Klavyeyi bağla ve tekrar dene.";
            }
        };
        bindInputs();
        midiAccess.onstatechange=()=>{bindInputs();};
    }catch(e){
        if(monitor) monitor.innerHTML="MIDI: ERİŞİM VERİLMEDİ.<br>Chrome/Edge izinlerini kontrol et ve sayfayı localhost üzerinden aç.";
        console.warn("MIDI init failed",e);
    }
}

async function handleMIDI(message){

    const data=message.data;

    const status=
        data[0]&0xf0;

    const channel=
        (data[0]&0x0f)+1;

    const note=data[1];
    const velocity=data[2];

    if(status===0xff){ stopAllVoices(); return; }
    if(status===0xb0 && (data[1]===120 || data[1]===123)){
        stopAllVoices();
        if($("midiMonitor")) $("midiMonitor").innerHTML="MIDI: ALL NOTES OFF<br>CH: "+channel;
        return;
    }

    if(status===0x90 && velocity>0){

        setKeyboardKeyActive(note,true);
        document.dispatchEvent(new CustomEvent("dede:visual-midi-note",{detail:{note,on:true,velocity}}));
        await startVoice(
            note,
            velocity
        );

        $("midiMonitor").innerHTML=
            "MIDI: NOTE ON<br>"+
            "CH: "+channel+
            "<br>"+
            "NOTE: "+
            midiName(note)+
            "<br>"+
            "VEL: "+
            velocity+
            "<br>"+
            "PB: "+
            pitchBend;
    }

    // MIDI CC1 (Modulation Wheel) controls the pre-insert sample volume.
    if((status & 0xf0)===0xb0 && data[1]===MODULATION_CC){
        const modValue=Math.max(0,Math.min(127,Number(data[2])||0));
        const modNorm=modValue/127;
        if(typeof window.setPerformanceModulation==="function"){
            window.setPerformanceModulation(modNorm);
        }else{
            modulationVolume=modNorm;
            const modUI=document.getElementById("uiModulation");
            const modVal=document.getElementById("uiModulationValue");
            if(modUI) modUI.value=modNorm;
            if(modVal) modVal.textContent=Math.round(modNorm*100)+"%";
        }
        $("midiMonitor").innerHTML="MIDI: CC1 MODULATION / PRE-INSERT VOLUME<br>CH: "+channel+"<br>NOTE: --<br>VEL: --<br>CC1: "+modValue;
        return;
    }

    if(
        status===0x80||
        (status===0x90&&velocity===0)
    ){

        setKeyboardKeyActive(note,false);
        document.dispatchEvent(new CustomEvent("dede:visual-midi-note",{detail:{note,on:false,velocity:0}}));
        releaseNote(note);
    }

    if(status===0xe0){

        const value=
            data[1]|
            (data[2]<<7);

        pitchBend=
            (
                value-8192
            )/8192;

        const pbUI=document.getElementById("uiPitchBend");
        const pbUIVal=document.getElementById("uiPitchBendValue");
        if(pbUI) pbUI.value=pitchBend;
        if(pbUIVal) pbUIVal.textContent=pitchBend.toFixed(3);
        applyPitchBendToVoices();

        $("midiMonitor").innerHTML=
            "MIDI: PITCH BEND<br>"+
            "CH: "+channel+
            "<br>"+
            "NOTE: --<br>"+
            "VEL: --<br>"+
            "PB: "+
            pitchBend.toFixed(3);
    }
}

