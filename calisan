<script id="general-edit-functional-controls-fix">
(()=>{
  const $=id=>document.getElementById(id);
  const ids=['cutoff','resonance','hpf','master','attack','decay','sustain','release','glide','pitchBendRange','legatoResponse','poly','mono','legato','portamento'];
  const num=(id,fallback)=>{const el=$(id); const n=Number(el?.value); return Number.isFinite(n)?n:fallback;};
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

  function refreshLabels(){
    const specs={
      cutoff: v=>`${Math.round(v*100)}%`,
      resonance: v=>v.toFixed(2),
      hpf: v=>`${Math.round(v)} Hz`,
      master: v=>`${Math.round(v*100)}%`,
      attack: v=>`${Math.round(v*1000)} ms`,
      decay: v=>`${v.toFixed(2)} s`,
      sustain: v=>`${Math.round(v*100)}%`,
      release: v=>`${v.toFixed(2)} s`,
      glide: v=>`${Math.round(v)} ms`
    };
    Object.entries(specs).forEach(([id,fmt])=>{
      const el=$(id); if(!el) return;
      let out=el.nextElementSibling;
      if(!out || (out.tagName!=='OUTPUT' && !out.classList.contains('geValue'))){
        out=document.createElement('output'); out.className='geValue';
        el.insertAdjacentElement('afterend',out);
      }
      out.textContent=fmt(Number(el.value));
    });
  }

  function applyAudioControls(){
    if(typeof audioContext==='undefined' || !audioContext) return;
    try{
      const now=audioContext.currentTime;
      if(fxChain?.master) fxChain.master.gain.setTargetAtTime(clamp(num('master',.85),0,1),now,.008);
      if(fxChain?.filter){
        // CUTOFF is a normalized control, mapped musically from 80 Hz to 20 kHz.
        const c=clamp(num('cutoff',.9),0,1);
        const freq=80*Math.pow(250, c); // 80Hz .. 20kHz
        fxChain.filter.frequency.setTargetAtTime(Math.max(20,Math.min(20000,freq)),now,.01);
        fxChain.filter.Q.setTargetAtTime(Math.max(.0001,num('resonance',1)),now,.01);
      }
      if(fxChain?.performanceHP){
        fxChain.performanceHP.frequency.setTargetAtTime(Math.max(20,Math.min(1000,num('hpf',20))),now,.01);
        fxChain.performanceHP.Q.setTargetAtTime(.0001,now,.01);
      }
      if(typeof updateFx==='function') updateFx();
    }catch(e){ console.warn('General Edit audio control',e); }
    refreshLabels();
  }

  function applyGlobalEnvelopeToActiveVoices(){
    if(typeof audioContext==='undefined' || !audioContext || !Array.isArray(window.activeVoices)) return;
    const rel=Math.max(.01,num('release',.5));
    try{
      window.activeVoices.forEach(v=>{
        if(v && v.type==='wav' && v.zoneRef?._customEnvelope!==true) v.releaseSeconds=rel;
      });
    }catch(_){ }
  }

  function refreshPerformanceStatus(){
    try{
      if(typeof updatePerformanceStatus==='function') updatePerformanceStatus();
      const v=num('glide',120); const out=$('glideValue'); if(out) out.textContent=Math.round(v)+' MS';
    }catch(_){ }
    refreshLabels();
  }

  // Use delegated input/change handlers so controls continue to work even after
  // General Edit moves the panels into its modal container.
  document.addEventListener('input',e=>{
    if(!e.target?.id || !ids.includes(e.target.id)) return;
